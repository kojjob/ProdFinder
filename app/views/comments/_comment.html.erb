<%= content_tag :div, id: "comment_#{comment.id}", class: "bg-gray-50 rounded-xl p-6 border border-gray-200 hover:border-gray-300 transition-colors duration-200" do %>
  <div class="flex items-start space-x-4">
    <!-- User Avatar -->
    <div class="flex-shrink-0">
      <%= link_to user_path(comment.user), class: "group" do %>
        <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-md group-hover:shadow-lg transition-shadow duration-200">
          <span class="text-white text-sm font-bold"><%= comment.user.full_name.first %></span>
        </div>
      <% end %>
    </div>
    <!-- Comment Content -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center space-x-2">
          <%= link_to comment.user.full_name, user_path(comment.user), 
              class: "font-semibold text-gray-900 hover:text-blue-600 transition-colors duration-200" %>
          <span class="text-sm text-gray-500">•</span>
          <time class="text-sm text-gray-500" datetime="<%= comment.created_at.iso8601 %>">
            <%= time_ago_in_words(comment.created_at) %> ago
          </time>
        </div>
        <!-- Delete Button (for comment owner) -->
        <% if user_signed_in? && comment.user == current_user %>
          <%= link_to product_comment_path(@product, comment), 
              method: :delete,
              data: { 
                turbo: true,
                turbo_method: :delete,
                action: "click->product#deleteComment"
              },
              class: "text-gray-400 hover:text-red-600 transition-colors duration-200" do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          <% end %>
        <% end %>
      </div>
      <div class="text-gray-700 leading-relaxed">
        <%= simple_format(comment.content) %>
      </div>
      <!-- Comment Actions -->
      <div class="flex items-center space-x-4 mt-3">
        <!-- Upvote Button -->
        <%= turbo_frame_tag "comment_upvote_#{comment.id}" do %>
          <%= link_to toggle_upvote_comment_path(comment), 
              class: "flex items-center space-x-1 text-sm text-gray-500 hover:text-blue-600 transition-colors duration-200",
              data: { turbo_method: :post } do %>
            <svg class="w-4 h-4 <%= 'text-blue-600' if current_user&.upvoted_comment?(comment) %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
            </svg>
            <span class="font-medium"><%= comment.upvotes_count %></span>
          <% end %>
        <% end %>
        <!-- Reply Button -->
        <button class="flex items-center space-x-1 text-sm text-gray-500 hover:text-blue-600 transition-colors duration-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"/>
          </svg>
          <span>Reply</span>
        </button>
      </div>
    </div>
  </div>
<% end %>
