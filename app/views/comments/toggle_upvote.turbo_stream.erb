<%= turbo_stream.replace "comment_upvote_#{@comment.id}" do %>
  <%= link_to toggle_upvote_product_comment_path(@product, @comment), 
      class: "flex items-center space-x-1 text-sm text-gray-500 hover:text-blue-600 transition-colors duration-200",
      data: { turbo_method: :post } do %>
    <svg class="w-4 h-4 <%= 'text-blue-600' if @upvoted %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
    </svg>
    <span class="font-medium"><%= @comment.upvotes_count %></span>
  <% end %>
<% end %>
