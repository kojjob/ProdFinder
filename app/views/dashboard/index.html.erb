<% content_for :title, "Dashboard - AfriHunt" %>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes shimmer {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
  }

  .animate-float { animation: float 6s ease-in-out infinite; }
  .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
  .animate-slide-up { animation: slide-up 0.6s ease-out forwards; }

  .glass-effect {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .gradient-border {
    position: relative;
    background: white;
  }

  .gradient-border::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
  }

  .gradient-border:hover::before {
    opacity: 1;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-purple-50/30">
  <!-- Header -->
  <div class="relative overflow-hidden bg-gradient-to-br from-red-600 via-blue-600 to-teal-500">
    <!-- Animated Background Patterns -->
    <div class="absolute inset-0 opacity-10">
      <svg class="absolute top-10 right-20 w-32 h-32 text-white animate-float" style="animation-delay: 0s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90,-16.3,88.5,-0.9C87,14.6,81.4,29.2,73.1,42.8C64.8,56.4,53.8,69,40.3,76.8C26.8,84.6,11.1,87.6,-4.8,85.9C-20.7,84.2,-41.4,77.8,-56.6,67.1C-71.8,56.4,-81.5,41.4,-85.6,25.1C-89.7,8.8,-88.2,-8.8,-82.3,-24.7C-76.4,-40.6,-66.1,-54.8,-53.1,-62.3C-40.1,-69.8,-24.4,-70.6,-9.3,-73.9C5.8,-77.2,30.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
      </svg>
      <svg class="absolute bottom-10 left-20 w-40 h-40 text-white animate-float" style="animation-delay: 1.5s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M39.5,-65.5C51.4,-58.3,61.3,-47.6,68.4,-35.2C75.5,-22.8,79.8,-8.7,79.3,5.3C78.8,19.3,73.5,33.2,65.1,45.3C56.7,57.4,45.2,67.7,32.1,73.4C19,79.1,4.3,80.2,-10.3,77.8C-24.9,75.4,-39.4,69.5,-51.8,60.3C-64.2,51.1,-74.5,38.6,-78.9,24.5C-83.3,10.4,-81.8,-5.3,-76.2,-19.4C-70.6,-33.5,-60.9,-46,-48.8,-53.6C-36.7,-61.2,-22.2,-63.9,-8.3,-66.8C5.6,-69.7,27.6,-72.7,39.5,-65.5Z" transform="translate(100 100)" />
      </svg>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div class="animate-slide-up">
          <div class="inline-flex items-center px-4 py-2 rounded-full glass-effect mb-4">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            <span class="text-sm font-semibold tracking-wide">Your Dashboard</span>
          </div>

          <h1 class="text-4xl md:text-5xl font-extrabold mb-3" style="letter-spacing: -0.02em;">
            Welcome back, <%= @user.full_name.split.first %>! 👋
          </h1>
          <p class="text-xl text-blue-100 max-w-2xl" style="font-weight: 300;">
            Here's what's happening with your products and community
          </p>
        </div>

        <!-- Quick Actions -->
        <div class="mt-6 md:mt-0 flex flex-wrap gap-3 animate-slide-up" style="animation-delay: 0.2s;">
          <%= link_to new_product_path, class: "inline-flex items-center px-6 py-3 border-2 border-white/30 rounded-xl text-base font-bold text-white glass-effect hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            New Product
          <% end %>
          <%= link_to new_collection_path, class: "inline-flex items-center px-6 py-3 border-2 border-white/30 rounded-xl text-base font-bold text-white glass-effect hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            New Collection
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      <!-- Total Products -->
      <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 animate-slide-up" style="animation-delay: 0.1s;">
        <div class="flex items-center justify-between mb-4">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
          </div>
          <% if @live_products_count > 0 %>
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-green-100 text-green-700">
              <%= @live_products_count %> Live
            </span>
          <% end %>
        </div>
        <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-1">Total Products</p>
        <p class="text-4xl font-extrabold text-gray-900"><%= @total_products %></p>
        <% if @draft_products_count > 0 %>
          <p class="text-sm text-gray-500 mt-2"><%= @draft_products_count %> draft<%= @draft_products_count == 1 ? '' : 's' %></p>
        <% end %>
      </div>

      <!-- Total Upvotes -->
      <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 animate-slide-up" style="animation-delay: 0.2s;">
        <div class="flex items-center justify-between mb-4">
          <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/>
            </svg>
          </div>
          <% if @new_upvotes_this_week > 0 %>
            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-100 text-blue-700">
              +<%= @new_upvotes_this_week %> this week
            </span>
          <% end %>
        </div>
        <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-1">Total Upvotes</p>
        <p class="text-4xl font-extrabold text-gray-900"><%= @total_upvotes_received %></p>
        <p class="text-sm text-gray-500 mt-2">Across all products</p>
      </div>

      <!-- Total Views -->
      <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 animate-slide-up" style="animation-delay: 0.3s;">
        <div class="flex items-center justify-between mb-4">
          <div class="w-14 h-14 bg-gradient-to-br from-teal-500 to-teal-600 rounded-xl flex items-center justify-center shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
          </div>
        </div>
        <p class="text-sm font-semibold text-gray-600 uppercase tracking-wide mb-1">Total Views</p>
        <p class="text-4xl font-extrabold text-gray-900"><%= number_with_delimiter(@total_views) %></p>
        <p class="text-sm text-gray-500 mt-2">Product page visits</p>
      </div>

      <!-- Community Stats -->
      <div class="bg-gradient-to-br from-red-600 via-blue-600 to-teal-500 rounded-2xl shadow-xl p-6 text-white hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1 animate-slide-up" style="animation-delay: 0.4s;">
        <div class="flex items-center justify-between mb-4">
          <div class="w-14 h-14 bg-white/20 rounded-xl flex items-center justify-center backdrop-blur-sm">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
        </div>
        <p class="text-sm font-semibold text-blue-100 uppercase tracking-wide mb-1">Community</p>
        <div class="flex items-baseline gap-3">
          <div>
            <p class="text-3xl font-extrabold"><%= @total_followers %></p>
            <p class="text-xs text-blue-100 mt-1">Followers</p>
          </div>
          <div class="text-2xl font-light opacity-50">•</div>
          <div>
            <p class="text-3xl font-extrabold"><%= @total_following %></p>
            <p class="text-xs text-blue-100 mt-1">Following</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Secondary Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white rounded-2xl shadow-md border border-gray-200/50 p-6 animate-slide-up" style="animation-delay: 0.5s;">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-gray-600 mb-1">Comments Received</p>
            <p class="text-3xl font-extrabold text-gray-900"><%= @total_comments_received %></p>
          </div>
          <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-md border border-gray-200/50 p-6 animate-slide-up" style="animation-delay: 0.6s;">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-gray-600 mb-1">Collections</p>
            <p class="text-3xl font-extrabold text-gray-900"><%= @total_collections %></p>
          </div>
          <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-md border border-gray-200/50 p-6 animate-slide-up" style="animation-delay: 0.7s;">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm font-semibold text-gray-600 mb-1">Reputation Score</p>
            <p class="text-3xl font-extrabold text-gray-900"><%= @user.reputation_score %></p>
          </div>
          <div class="w-12 h-12 bg-pink-100 rounded-xl flex items-center justify-center">
            <svg class="w-6 h-6 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
    <!-- Quick Links -->
    <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 p-8 mb-12 animate-slide-up" style="animation-delay: 0.8s;">
      <h2 class="text-2xl font-extrabold text-gray-900 mb-6 flex items-center" style="letter-spacing: -0.01em;">
        <svg class="w-6 h-6 mr-3 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Quick Links
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <%= link_to my_products_path, class: "group p-6 rounded-xl border-2 border-gray-200 hover:border-blue-500 hover:bg-red-50 transition-all duration-300 transform hover:-translate-y-1" do %>
          <div class="flex flex-col items-center text-center">
            <div class="w-14 h-14 bg-blue-100 group-hover:bg-blue-600 rounded-xl flex items-center justify-center mb-3 transition-colors duration-300">
              <svg class="w-7 h-7 text-red-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
            </div>
            <p class="font-bold text-gray-900 group-hover:text-red-600 transition-colors duration-300">My Products</p>
          </div>
        <% end %>

        <%= link_to edit_user_path(@user), class: "group p-6 rounded-xl border-2 border-gray-200 hover:border-purple-500 hover:bg-blue-50 transition-all duration-300 transform hover:-translate-y-1" do %>
          <div class="flex flex-col items-center text-center">
            <div class="w-14 h-14 bg-purple-100 group-hover:bg-purple-600 rounded-xl flex items-center justify-center mb-3 transition-colors duration-300">
              <svg class="w-7 h-7 text-blue-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <p class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors duration-300">Edit Profile</p>
          </div>
        <% end %>

        <%= link_to settings_path, class: "group p-6 rounded-xl border-2 border-gray-200 hover:border-pink-500 hover:bg-teal-50 transition-all duration-300 transform hover:-translate-y-1" do %>
          <div class="flex flex-col items-center text-center">
            <div class="w-14 h-14 bg-pink-100 group-hover:bg-pink-600 rounded-xl flex items-center justify-center mb-3 transition-colors duration-300">
              <svg class="w-7 h-7 text-teal-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <p class="font-bold text-gray-900 group-hover:text-teal-600 transition-colors duration-300">Settings</p>
          </div>
        <% end %>

        <%= link_to products_path, class: "group p-6 rounded-xl border-2 border-gray-200 hover:border-green-500 hover:bg-green-50 transition-all duration-300 transform hover:-translate-y-1" do %>
          <div class="flex flex-col items-center text-center">
            <div class="w-14 h-14 bg-green-100 group-hover:bg-green-600 rounded-xl flex items-center justify-center mb-3 transition-colors duration-300">
              <svg class="w-7 h-7 text-green-600 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
            <p class="font-bold text-gray-900 group-hover:text-green-600 transition-colors duration-300">Explore</p>
          </div>
        <% end %>
      </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Recent Products -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 p-8 animate-slide-up" style="animation-delay: 0.9s;">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-extrabold text-gray-900 flex items-center" style="letter-spacing: -0.01em;">
              <svg class="w-6 h-6 mr-3 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
              </svg>
              Your Products
            </h2>
            <%= link_to my_products_path, class: "inline-flex items-center px-4 py-2 rounded-xl text-sm font-bold text-red-600 bg-red-50 hover:bg-blue-100 transition-all duration-200" do %>
              View All
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
              </svg>
            <% end %>
          </div>
          <% if @recent_products.any? %>
            <div class="space-y-4">
              <% @recent_products.each do |product| %>
                <%= link_to product_path(product), class: "block group" do %>
                  <div class="flex items-start gap-4 p-5 border-2 border-gray-200 rounded-xl hover:border-blue-500 hover:bg-red-50/50 transition-all duration-300">
                    <div class="w-16 h-16 bg-gradient-to-br from-blue-100 to-purple-100 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                      <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-2 mb-1">
                        <h3 class="font-extrabold text-gray-900 group-hover:text-red-600 transition-colors duration-300 truncate"><%= product.name %></h3>
                        <% if product.live? %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-bold bg-green-100 text-green-700">
                            LIVE
                          </span>
                        <% elsif product.draft? %>
                          <span class="inline-flex items-center px-2 py-0.5 rounded-md text-xs font-bold bg-gray-100 text-gray-700">
                            DRAFT
                          </span>
                        <% end %>
                      </div>
                      <p class="text-sm text-gray-600 mb-3 line-clamp-1"><%= product.tagline %></p>
                      <div class="flex items-center gap-4 text-sm text-gray-500">
                        <span class="flex items-center gap-1.5">
                          <svg class="w-4 h-4 text-pink-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                          </svg>
                          <span class="font-semibold"><%= product.views_count %></span>
                        </span>
                        <span class="flex items-center gap-1.5">
                          <svg class="w-4 h-4 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/>
                          </svg>
                          <span class="font-semibold"><%= product.upvotes_count %></span>
                        </span>
                        <span class="flex items-center gap-1.5">
                          <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                          </svg>
                          <span class="font-semibold"><%= product.comments_count %></span>
                        </span>
                        <span class="text-xs text-gray-400 ml-auto">
                          <%= time_ago_in_words(product.created_at) %> ago
                        </span>
                      </div>
                    </div>
                    <div class="flex flex-col gap-2">
                      <%= link_to edit_product_path(product), class: "p-2 rounded-lg text-gray-400 hover:text-red-600 hover:bg-red-50 transition-all duration-200", onclick: "event.stopPropagation();" do %>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-16">
              <div class="w-20 h-20 bg-gradient-to-br from-blue-100 to-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
              </div>
              <h3 class="text-xl font-extrabold text-gray-900 mb-2">No products yet</h3>
              <p class="text-gray-600 mb-6 max-w-sm mx-auto">Launch your first product and start building your presence in the African tech community!</p>
              <%= link_to new_product_path, class: "inline-flex items-center px-6 py-3 border-2 border-transparent rounded-xl text-base font-bold text-white bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                </svg>
                Launch Your First Product
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Collections -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 p-6 animate-slide-up" style="animation-delay: 1.0s;">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-extrabold text-gray-900 flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
              </svg>
              Collections
            </h3>
            <%= link_to new_collection_path, class: "inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold text-blue-600 bg-blue-50 hover:bg-purple-100 transition-all duration-200" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              New
            <% end %>
          </div>
          <% if @recent_collections.any? %>
            <div class="space-y-3">
              <% @recent_collections.each do |collection| %>
                <div class="group p-3 rounded-xl border-2 border-gray-200 hover:border-purple-500 hover:bg-blue-50/50 transition-all duration-300">
                  <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-gradient-to-br from-purple-100 to-pink-100 rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                      <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                      </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                      <h4 class="font-bold text-gray-900 group-hover:text-blue-600 transition-colors duration-300 truncate"><%= collection.name %></h4>
                      <p class="text-sm text-gray-600"><%= collection.products_count %> product<%= collection.products_count == 1 ? '' : 's' %></p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                </svg>
              </div>
              <p class="text-sm text-gray-600 mb-3">No collections yet</p>
              <%= link_to "Create One", new_collection_path, class: "text-sm font-bold text-blue-600 hover:text-purple-700" %>
            </div>
          <% end %>
        </div>

        <!-- Notifications -->
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 p-6 animate-slide-up" style="animation-delay: 1.1s;">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-lg font-extrabold text-gray-900 flex items-center">
              <svg class="w-5 h-5 mr-2 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
              </svg>
              Notifications
            </h3>
            <% if @unread_notifications.any? %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-red-100 text-red-700">
                <%= @unread_notifications.count %>
              </span>
            <% end %>
          </div>
          <% if @unread_notifications.any? %>
            <div class="space-y-3">
              <% @unread_notifications.each do |notification| %>
                <div class="p-3 rounded-xl bg-red-50 border-2 border-blue-200 hover:bg-blue-100 transition-all duration-200">
                  <div class="flex items-start gap-3">
                    <div class="w-2 h-2 bg-blue-600 rounded-full mt-2 flex-shrink-0"></div>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-semibold text-gray-900"><%= notification.title %></p>
                      <% if notification.body.present? %>
                        <p class="text-xs text-gray-600 mt-1"><%= notification.body %></p>
                      <% end %>
                      <p class="text-xs text-gray-500 mt-1"><%= time_ago_in_words(notification.created_at) %> ago</p>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
              </div>
              <p class="text-sm text-gray-600">All caught up! 🎉</p>
            </div>
          <% end %>
        </div>

        <!-- Recent Activity -->
        <div class="bg-gradient-to-br from-red-600 via-blue-600 to-teal-500 rounded-2xl shadow-xl p-6 text-white animate-slide-up" style="animation-delay: 1.2s;">
          <h3 class="text-lg font-extrabold mb-5 flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Recent Activity
          </h3>
          <% if @recent_upvotes.any? || @recent_comments.any? %>
            <div class="space-y-3">
              <% @recent_upvotes.first(3).each do |upvote| %>
                <div class="flex items-start gap-3 p-3 rounded-xl bg-white/10 backdrop-blur-sm">
                  <div class="w-2 h-2 bg-pink-300 rounded-full mt-2 flex-shrink-0"></div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold">You upvoted <%= upvote.product.name %></p>
                    <p class="text-xs text-blue-100 mt-1"><%= time_ago_in_words(upvote.created_at) %> ago</p>
                  </div>
                </div>
              <% end %>
              <% @recent_comments.first(2).each do |comment| %>
                <div class="flex items-start gap-3 p-3 rounded-xl bg-white/10 backdrop-blur-sm">
                  <div class="w-2 h-2 bg-blue-300 rounded-full mt-2 flex-shrink-0"></div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold">You commented on <%= comment.product.name %></p>
                    <p class="text-xs text-blue-100 mt-1"><%= time_ago_in_words(comment.created_at) %> ago</p>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-8">
              <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center mx-auto mb-3 backdrop-blur-sm">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <p class="text-sm text-blue-100">Start exploring products!</p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
