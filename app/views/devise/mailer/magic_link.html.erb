<%
  @magic_link = magic_link_url(@resource, @scope_name => {email: @resource.email, token: @token, remember_me: @remember_me})
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Your Magic Link - ProdFinder</title>
  <!--[if mso]>
  <style type="text/css">
    body, table, td {font-family: Arial, sans-serif !important;}
  </style>
  <![endif]-->
</head>
<body style="margin: 0; padding: 0; background-color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;">
  <!-- Wrapper Table -->
  <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background-color: #f8fafc; padding: 40px 20px;">
    <tr>
      <td align="center">
        <!-- Main Container -->
        <table cellpadding="0" cellspacing="0" border="0" width="600" style="max-width: 600px; background-color: #ffffff; border-radius: 24px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);">

          <!-- Header with Logo -->
          <tr>
            <td align="center" style="padding: 48px 40px 32px 40px;">
              <!-- Logo/Brand Icon -->
              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="width: 64px; height: 64px; background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(37, 99, 235, 0.1) 100%); border-radius: 50%; border: 1px solid rgba(59, 130, 246, 0.2);">
                    <!-- Lightning Bolt Icon -->
                    <div style="font-size: 28px; line-height: 64px; color: #3b82f6;">⚡</div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Title -->
          <tr>
            <td align="center" style="padding: 0 40px 16px 40px;">
              <h1 style="margin: 0; font-size: 28px; font-weight: 600; color: #1e293b; line-height: 1.2; letter-spacing: -0.02em;">
                Your magic link is ready
              </h1>
            </td>
          </tr>

          <!-- Subtitle -->
          <tr>
            <td align="center" style="padding: 0 40px 32px 40px;">
              <p style="margin: 0; font-size: 16px; color: #64748b; line-height: 1.5;">
                Click the button below to sign in to your ProdFinder account.
              </p>
            </td>
          </tr>

          <!-- Magic Link Button -->
          <tr>
            <td align="center" style="padding: 0 40px 32px 40px;">
              <table cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="border-radius: 12px; background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.3), 0 2px 4px -1px rgba(59, 130, 246, 0.2);">
                    <a href="<%= @magic_link %>" style="display: inline-block; padding: 16px 40px; font-size: 16px; font-weight: 600; color: #ffffff; text-decoration: none; letter-spacing: -0.01em;">
                      Sign in to ProdFinder
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Divider -->
          <tr>
            <td align="center" style="padding: 0 40px 24px 40px;">
              <p style="margin: 0; font-size: 13px; color: #94a3b8;">
                Or copy and paste this URL into your browser:
              </p>
            </td>
          </tr>

          <!-- URL Copy Box -->
          <tr>
            <td align="center" style="padding: 0 40px 32px 40px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td style="background-color: #f1f5f9; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px;">
                    <a href="<%= @magic_link %>" style="font-size: 13px; color: #3b82f6; text-decoration: none; word-break: break-all; display: block;">
                      <%= @magic_link %>
                    </a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Security Info Card -->
          <tr>
            <td align="center" style="padding: 0 40px 32px 40px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%" style="background: linear-gradient(135deg, rgba(251, 191, 36, 0.08) 0%, rgba(245, 158, 11, 0.08) 100%); border: 1px solid rgba(251, 191, 36, 0.2); border-radius: 12px;">
                <tr>
                  <td style="padding: 16px 20px;">
                    <table cellpadding="0" cellspacing="0" border="0" width="100%">
                      <tr>
                        <td width="32" valign="top" style="padding-right: 12px;">
                          <div style="width: 20px; height: 20px; font-size: 16px; line-height: 20px; color: #f59e0b;">⏱️</div>
                        </td>
                        <td valign="middle">
                          <p style="margin: 0; font-size: 13px; color: #78350f; line-height: 1.5;">
                            <strong style="font-weight: 600;">This link expires in <%= Devise.passwordless_login_within.inspect %></strong> and can only be used once for your security.
                          </p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Help Section -->
          <tr>
            <td align="center" style="padding: 0 40px 32px 40px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td align="center" style="padding-bottom: 16px;">
                    <p style="margin: 0; font-size: 14px; font-weight: 600; color: #1e293b;">
                      Didn't request this email?
                    </p>
                  </td>
                </tr>
                <tr>
                  <td align="center">
                    <p style="margin: 0; font-size: 13px; color: #64748b; line-height: 1.6;">
                      If you didn't request this magic link, you can safely ignore this email.
                      <br>Someone may have entered your email address by mistake.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="padding: 32px 40px 40px 40px; border-top: 1px solid #f1f5f9;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <!-- Company Info -->
                <tr>
                  <td align="center" style="padding-bottom: 16px;">
                    <p style="margin: 0; font-size: 12px; color: #94a3b8; line-height: 1.5;">
                      This email was sent by ProdFinder
                      <br>
                      <a href="<%= root_url %>" style="color: #3b82f6; text-decoration: none;"><%= root_url %></a>
                    </p>
                  </td>
                </tr>

                <!-- Social Links (Optional) -->
                <tr>
                  <td align="center" style="padding-bottom: 16px;">
                    <table cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto;">
                      <tr>
                        <td style="padding: 0 8px;">
                          <a href="#" style="color: #94a3b8; text-decoration: none; font-size: 12px;">Twitter</a>
                        </td>
                        <td style="padding: 0 8px; color: #cbd5e1;">•</td>
                        <td style="padding: 0 8px;">
                          <a href="#" style="color: #94a3b8; text-decoration: none; font-size: 12px;">LinkedIn</a>
                        </td>
                        <td style="padding: 0 8px; color: #cbd5e1;">•</td>
                        <td style="padding: 0 8px;">
                          <a href="#" style="color: #94a3b8; text-decoration: none; font-size: 12px;">Help Center</a>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>

                <!-- Legal Links -->
                <tr>
                  <td align="center">
                    <p style="margin: 0; font-size: 11px; color: #cbd5e1; line-height: 1.5;">
                      <a href="#" style="color: #94a3b8; text-decoration: none;">Privacy Policy</a>
                      <span style="margin: 0 8px;">•</span>
                      <a href="#" style="color: #94a3b8; text-decoration: none;">Terms of Service</a>
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

        </table>

        <!-- Security Notice Outside Main Card -->
        <table cellpadding="0" cellspacing="0" border="0" width="600" style="max-width: 600px; margin-top: 24px;">
          <tr>
            <td align="center" style="padding: 0 20px;">
              <table cellpadding="0" cellspacing="0" border="0" width="100%">
                <tr>
                  <td width="32" valign="top" style="padding-right: 12px;">
                    <div style="width: 18px; height: 18px; font-size: 14px; line-height: 18px; color: #94a3b8;">🔒</div>
                  </td>
                  <td valign="middle">
                    <p style="margin: 0; font-size: 12px; color: #64748b; line-height: 1.6;">
                      ProdFinder will never ask you for your password via email. This link provides secure, passwordless access to your account.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>
