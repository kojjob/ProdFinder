<% content_for :title, "Sign Up - AfriHunt" %>
<div class="auth-container">
  <div class="auth-form" data-controller="signup-form">
    <!-- Premium Header with Red-Blue-Teal Gradient -->
    <div class="text-center mb-12">
      <!-- AfriHunt Logo Mark with Gradient -->
      <div class="inline-flex items-center justify-center w-16 h-16 mb-6 bg-gradient-to-br from-red-500/10 via-blue-500/10 to-teal-500/10 rounded-2xl backdrop-blur-sm border border-red-200/30 shadow-sm">
        <svg class="w-8 h-8 text-transparent bg-clip-text bg-gradient-to-br from-red-600 via-blue-600 to-teal-500" fill="currentColor" viewBox="0 0 24 24">
          <path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <h1 class="text-4xl font-bold text-gray-900 mb-3 tracking-tight">
        Join AfriHunt
      </h1>
      <p class="text-lg text-gray-600 font-normal">
        Discover and launch amazing African products
      </p>
    </div>
    <!-- Flash Messages -->
    <%= render "shared/flash_messages" %>
    <!-- Error Messages -->
    <%= render "devise/shared/error_messages", resource: resource %>
    <!-- Success State (hidden by default) - Teal Theme -->
    <div class="hidden mb-8" data-signup-form-target="successState">
      <div class="bg-gradient-to-br from-teal-50/80 to-teal-100/60 backdrop-blur-sm rounded-3xl p-8 border border-teal-200/50 shadow-lg text-center">
        <!-- Success checkmark animation with Teal -->
        <div class="inline-flex items-center justify-center w-16 h-16 mb-5 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full shadow-md">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h2 class="text-xl font-bold text-gray-900 mb-2">
          Check your inbox
        </h2>
        <p class="text-base text-gray-700 leading-relaxed">
          We've sent a confirmation email to <span class="font-semibold text-teal-700" data-signup-form-target="emailDisplay"></span>
        </p>
        <p class="text-sm text-gray-600 mt-3">
          Click the link in the email to activate your account
        </p>
      </div>
    </div>
    <!-- Sign Up Form -->
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
                  html: {
                    class: "space-y-5",
                    data: {
                      signup_form_target: "form",
                      turbo_frame: "auth_form"
                    }
                  }) do |f| %>
      <!-- Email Field with Enhanced Styling -->
      <div class="form-field" data-signup-form-target="formFields">
        <%= f.label :email, "Email address", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="relative group">
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                required: true,
                placeholder: "you@example.com",
                class: "w-full h-14 px-5 text-base rounded-2xl border-2 border-gray-200 focus:border-red-500 focus:ring-4 focus:ring-red-100 transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300",
                data: {
                  action: "input->signup-form#validateEmail blur->signup-form#validateEmail",
                  signup_form_target: "emailInput"
                } %>
          <!-- Validation icon with Teal color -->
          <div class="absolute inset-y-0 right-0 pr-5 flex items-center pointer-events-none">
            <svg class="h-6 w-6 text-teal-500 opacity-0 scale-0 transition-all duration-300"
                 data-signup-form-target="emailValidIcon"
                 fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.236 4.53L8.23 10.661a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        <!-- Validation message with Red color -->
        <div class="hidden mt-2.5 text-red-600 text-sm" data-signup-form-target="emailError">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span data-signup-form-target="emailErrorText"></span>
          </div>
        </div>
      </div>
      <!-- Username Field with Enhanced Styling -->
      <div class="form-field" data-signup-form-target="formFields">
        <%= f.label :username, "Username", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="relative group">
          <%= f.text_field :username,
                autocomplete: "username",
                required: true,
                placeholder: "your_username",
                class: "w-full h-14 px-5 text-base rounded-2xl border-2 border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300",
                data: {
                  action: "input->signup-form#validateUsername blur->signup-form#validateUsername",
                  signup_form_target: "usernameInput"
                } %>
          <!-- Validation icon with Teal color -->
          <div class="absolute inset-y-0 right-0 pr-5 flex items-center pointer-events-none">
            <svg class="h-6 w-6 text-teal-500 opacity-0 scale-0 transition-all duration-300"
                 data-signup-form-target="usernameValidIcon"
                 fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.236 4.53L8.23 10.661a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        <!-- Validation message with Red color -->
        <div class="hidden mt-2.5 text-red-600 text-sm" data-signup-form-target="usernameError">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span data-signup-form-target="usernameErrorText"></span>
          </div>
        </div>
        <p class="text-sm text-gray-600 mt-2.5 flex items-center">
          <svg class="h-4 w-4 mr-1.5 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
          </svg>
          3-30 characters, letters, numbers, and underscores
        </p>
      </div>
      <!-- Full Name Field with Enhanced Styling -->
      <div class="form-field" data-signup-form-target="formFields">
        <%= f.label :full_name, "Full name", class: "block text-sm font-semibold text-gray-700 mb-2" %>
        <div class="relative group">
          <%= f.text_field :full_name,
                autocomplete: "name",
                required: true,
                placeholder: "John Doe",
                class: "w-full h-14 px-5 text-base rounded-2xl border-2 border-gray-200 focus:border-teal-500 focus:ring-4 focus:ring-teal-100 transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300",
                data: {
                  action: "input->signup-form#validateName blur->signup-form#validateName",
                  signup_form_target: "nameInput"
                } %>
          <!-- Validation icon with Teal color -->
          <div class="absolute inset-y-0 right-0 pr-5 flex items-center pointer-events-none">
            <svg class="h-6 w-6 text-teal-500 opacity-0 scale-0 transition-all duration-300"
                 data-signup-form-target="nameValidIcon"
                 fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.236 4.53L8.23 10.661a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        <!-- Validation message with Red color -->
        <div class="hidden mt-2.5 text-red-600 text-sm" data-signup-form-target="nameError">
          <div class="flex items-center">
            <svg class="h-5 w-5 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>
            <span data-signup-form-target="nameErrorText"></span>
          </div>
        </div>
      </div>
      <!-- Submit Button with Red-Blue-Teal Gradient -->
      <div class="space-y-4 pt-4" data-signup-form-target="formFields">
        <%= f.submit "Create Account",
              class: "w-full h-16 text-lg font-bold text-white bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 rounded-2xl shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 cursor-pointer",
              data: {
                signup_form_target: "submitButton",
                action: "click->signup-form#handleSubmit"
              } %>
        <!-- Loading state with Red spinner -->
        <div class="hidden" data-signup-form-target="loadingMessage">
          <div class="flex items-center justify-center space-x-3 text-base text-gray-700 bg-gray-50 backdrop-blur-sm rounded-2xl py-5 px-6 border-2 border-gray-200">
            <svg class="animate-spin h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3"></circle>
              <path class="opacity-80" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span class="font-semibold">Creating your account...</span>
          </div>
        </div>
      </div>
    <% end %>
    <!-- Footer Links with Blue accent -->
    <div class="mt-10 pt-8 border-t-2 border-gray-200">
      <p class="text-center text-base text-gray-600">
        Already have an account?
        <%= link_to "Sign in", new_session_path(resource_name),
              class: "text-blue-600 hover:text-blue-700 font-bold ml-2 transition-colors" %>
      </p>
    </div>
    <!-- Terms and Privacy with better styling -->
    <div class="mt-6">
      <p class="text-center text-sm text-gray-600 leading-relaxed">
        By creating an account, you agree to our
        <%= link_to "Terms of Service", "#", class: "text-blue-600 hover:text-blue-700 font-medium transition-colors" %>
        and
        <%= link_to "Privacy Policy", "#", class: "text-blue-600 hover:text-blue-700 font-medium transition-colors" %>
      </p>
    </div>
    <!-- Help Text with Icon -->
    <div class="mt-8">
      <div class="text-center bg-gradient-to-br from-gray-50 to-gray-100/50 backdrop-blur-sm rounded-2xl py-5 px-6 border-2 border-gray-200">
        <p class="text-sm text-gray-600 leading-relaxed flex items-center justify-center">
          <svg class="h-5 w-5 mr-2 text-teal-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
          </svg>
          <span class="font-medium">No password required – sign in with secure magic links</span>
        </p>
      </div>
    </div>
  </div>
</div>
