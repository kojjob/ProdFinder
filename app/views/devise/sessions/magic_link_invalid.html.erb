<% content_for :title, "Invalid Link - AfriHunt" %>

<div class="auth-container">
  <div class="auth-form">
    <!-- Error Icon with Red gradient -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center justify-center w-24 h-24 mb-8 bg-gradient-to-br from-red-50 to-red-100 rounded-full border-2 border-red-300/50 shadow-lg">
        <svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
      </div>

      <h1 class="text-4xl font-bold text-gray-900 mb-4 tracking-tight">
        This link isn't valid
      </h1>
      <p class="text-lg text-gray-700 leading-relaxed max-w-md mx-auto font-medium">
        The magic link you clicked has expired or is no longer valid.
      </p>
    </div>

    <!-- Error Details Card with enhanced styling -->
    <div class="bg-gradient-to-br from-red-50/80 to-red-100/60 backdrop-blur-sm rounded-3xl p-8 mb-8 border-2 border-red-200/50 shadow-lg">
      <h2 class="text-base font-bold text-gray-900 mb-5">
        This usually happens when:
      </h2>
      <ul class="space-y-4 text-sm text-gray-700">
        <li class="flex items-start space-x-3">
          <svg class="h-6 w-6 text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
          <span class="font-medium">The link has expired (magic links are valid for 20 minutes)</span>
        </li>
        <li class="flex items-start space-x-3">
          <svg class="h-6 w-6 text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
          <span class="font-medium">The link has already been used</span>
        </li>
        <li class="flex items-start space-x-3">
          <svg class="h-6 w-6 text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
          <span class="font-medium">A newer magic link was requested for this email</span>
        </li>
        <li class="flex items-start space-x-3">
          <svg class="h-6 w-6 text-red-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.28 7.22a.75.75 0 00-1.06 1.06L8.94 10l-1.72 1.72a.75.75 0 101.06 1.06L10 11.06l1.72 1.72a.75.75 0 101.06-1.06L11.06 10l1.72-1.72a.75.75 0 00-1.06-1.06L10 8.94 8.28 7.22z" clip-rule="evenodd" />
          </svg>
          <span class="font-medium">The link was copied incorrectly or is incomplete</span>
        </li>
      </ul>
    </div>

    <!-- Action Buttons with enhanced styling -->
    <div class="space-y-5">
      <p class="text-base text-gray-700 text-center mb-4 font-medium">
        No worries! Let's get you signed in.
      </p>

      <%= link_to new_session_path(resource_name),
            class: "w-full h-16 text-lg font-bold text-white bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 rounded-2xl shadow-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 flex items-center justify-center group" do %>
        <span>Request a new magic link</span>
        <svg class="ml-2 h-6 w-6 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      <% end %>

      <div class="flex items-center justify-center space-x-4 text-base">
        <%= link_to "Go to homepage",
              root_path,
              class: "text-gray-600 hover:text-gray-900 font-bold transition-colors" %>
        <span class="text-gray-300 font-bold">•</span>
        <%= link_to "Contact support",
              "#",
              class: "text-gray-600 hover:text-gray-900 font-bold transition-colors" %>
      </div>
    </div>

    <!-- Help Section with Teal accent -->
    <div class="mt-10 pt-8 border-t-2 border-gray-200">
      <div class="bg-gradient-to-br from-teal-50/50 to-teal-100/30 backdrop-blur-sm rounded-2xl py-5 px-6 border-2 border-teal-200/50">
        <div class="flex items-start space-x-3">
          <svg class="h-6 w-6 text-teal-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
          </svg>
          <div class="flex-1">
            <p class="text-sm text-gray-700 leading-relaxed">
              <span class="font-bold text-gray-900 block mb-1">Pro tip</span>
              <span class="font-medium">Magic links are single-use and expire after 20 minutes for your security.
              Always use the most recent link sent to your email.</span>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Security Notice -->
    <div class="mt-6 text-center">
      <p class="text-sm text-gray-600 font-medium">
        <svg class="inline-block h-5 w-5 mr-1.5 text-teal-500" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        Your account security is important to us
      </p>
    </div>
  </div>
</div>
