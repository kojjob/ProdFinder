<% content_for :title, "Welcome - AfriHunt" %>

<div class="auth-container">
  <div class="auth-form" data-controller="redirect" data-redirect-url-value="<%= after_sign_in_path_for(current_user) %>" data-redirect-delay-value="2000">
    <!-- Success Animation with Teal -->
    <div class="text-center">
      <!-- Large Success Icon with Teal Gradient -->
      <div class="inline-flex items-center justify-center w-28 h-28 mb-8 bg-gradient-to-br from-teal-500 to-teal-600 rounded-full shadow-xl animate-pulse">
        <svg class="w-14 h-14 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <!-- Welcome Message -->
      <h1 class="text-5xl font-bold text-gray-900 mb-4 tracking-tight">
        Welcome<%= current_user ? ", #{current_user.full_name.split.first}" : "" %>!
      </h1>
      <p class="text-xl text-gray-700 leading-relaxed mb-12 font-medium">
        You've been signed in successfully
      </p>

      <!-- Loading Progress with Red-Blue-Teal Gradient -->
      <div class="max-w-md mx-auto mb-8">
        <div class="relative">
          <!-- Progress Bar Background -->
          <div class="h-3 bg-gray-200 rounded-full overflow-hidden">
            <!-- Animated Progress Bar with Gradient -->
            <div class="h-full bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 rounded-full animate-progress"></div>
          </div>

          <!-- Status Text -->
          <p class="text-base text-gray-600 mt-4 animate-pulse font-semibold">
            Taking you to your dashboard...
          </p>
        </div>
      </div>

      <!-- Quick Stats with Red-Blue-Teal accents -->
      <div class="grid grid-cols-3 gap-4 mt-12 max-w-lg mx-auto">
        <div class="bg-gradient-to-br from-red-50/80 to-red-100/60 backdrop-blur-sm rounded-2xl p-5 border-2 border-red-200/50 animate-fade-in-delay-1">
          <div class="text-3xl font-bold text-red-600 mb-1">100+</div>
          <div class="text-sm text-gray-700 font-medium">Products</div>
        </div>

        <div class="bg-gradient-to-br from-blue-50/80 to-blue-100/60 backdrop-blur-sm rounded-2xl p-5 border-2 border-blue-200/50 animate-fade-in-delay-2">
          <div class="text-3xl font-bold text-blue-600 mb-1">24/7</div>
          <div class="text-sm text-gray-700 font-medium">Support</div>
        </div>

        <div class="bg-gradient-to-br from-teal-50/80 to-teal-100/60 backdrop-blur-sm rounded-2xl p-5 border-2 border-teal-200/50 animate-fade-in-delay-3">
          <div class="text-3xl font-bold text-teal-600 mb-1">∞</div>
          <div class="text-sm text-gray-700 font-medium">Possibilities</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes progress-bar {
    0% {
      width: 0%;
    }
    100% {
      width: 100%;
    }
  }

  @keyframes fade-in-delay {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-progress {
    animation: progress-bar 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-fade-in-delay-1 {
    animation: fade-in-delay 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
  }

  .animate-fade-in-delay-2 {
    animation: fade-in-delay 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s backwards;
  }

  .animate-fade-in-delay-3 {
    animation: fade-in-delay 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.8s backwards;
  }
</style>
