<% content_for :title, "Welcome - ProdFinder" %>

<div class="auth-container">
  <div class="auth-form " data-controller="redirect" data-redirect-url-value="<%= after_sign_in_path_for(current_user) %>" data-redirect-delay-value="2000">
    <!-- Success Animation -->
    <div class="text-center">
      <!-- Large Success Icon with Pulsing Animation -->
      <div class="inline-flex items-center justify-center w-24 h-24 mb-8 bg-gradient-to-br from-emerald-500 to-green-600 rounded-full shadow-lg ">
        <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <!-- Welcome Message -->
      <h1 class="text-4xl font-semibold text-gray-900 mb-4 tracking-tight ">
        Welcome<%= current_user ? ", #{current_user.first_name}" : "" %>!
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-12">
        You've been signed in successfully
      </p>

      <!-- Loading Progress -->
      <div class="max-w-md mx-auto mb-8">
        <div class="relative">
          <!-- Progress Bar Background -->
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <!-- Animated Progress Bar -->
            <div class="h-full bg-gradient-to-r from-blue-500 to-blue-600 rounded-full "></div>
          </div>

          <!-- Status Text -->
          <p class="text-sm text-gray-500 mt-4 animate-pulse">
            Taking you to your dashboard...
          </p>
        </div>
      </div>

      <!-- Quick Stats / Features Preview (Optional) -->
      <div class="grid grid-cols-3 gap-4 mt-12 max-w-lg mx-auto">
        <div class="bg-gradient-to-br from-blue-50/80 to-blue-100/60 backdrop-blur-sm rounded-2xl p-4 border border-blue-200/50-1">
          <div class="text-2xl font-bold text-blue-600 mb-1">100+</div>
          <div class="text-xs text-gray-600">Products</div>
        </div>

        <div class="bg-gradient-to-br from-blue-50/80 to-blue-100/60 backdrop-blur-sm rounded-2xl p-4 border border-blue-200/50-2">
          <div class="text-2xl font-bold text-blue-600 mb-1">24/7</div>
          <div class="text-xs text-gray-600">Support</div>
        </div>

        <div class="bg-gradient-to-br from-blue-50/80 to-blue-100/60 backdrop-blur-sm rounded-2xl p-4 border border-blue-200/50-3">
          <div class="text-2xl font-bold text-blue-600 mb-1">∞</div>
          <div class="text-xs text-gray-600">Possibilities</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes scale-pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  @keyframes progress-bar {
    0% {
      width: 0%;
    }
    100% {
      width: 100%;
    }
  }

  @keyframes fade-in-delay {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  . {
    animation: scale-pulse 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  . {
    animation: progress-bar 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .-delay {
    animation: fade-in-delay 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards;
  }

  .-delay-1 {
    animation: fade-in-delay 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.4s backwards;
  }

  .-delay-2 {
    animation: fade-in-delay 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.6s backwards;
  }

  .-delay-3 {
    animation: fade-in-delay 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.8s backwards;
  }

  .shadow-lg {
    box-shadow: 0 10px 30px -5px rgba(16, 185, 129, 0.4),
                0 0 0 1px rgba(16, 185, 129, 0.1);
  }
</style>
