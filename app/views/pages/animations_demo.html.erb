<% content_for :title, "Animations Demo - AfriHunt" %>

<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-5xl font-extrabold text-transparent bg-gradient-to-r from-red-600 via-blue-600 to-teal-600 bg-clip-text mb-4" style="letter-spacing: -0.02em;">
        🎭 Animations Demo
      </h1>
      <p class="text-xl text-gray-600">
        Experience all the micro-interactions and animations in AfriHunt
      </p>
    </div>

    <!-- Toast Notifications Demo -->
    <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6">🔔 Toast Notifications</h2>
      <p class="text-gray-600 mb-6">Click the buttons below to see different toast notifications:</p>
      
      <div class="flex flex-wrap gap-4">
        <button onclick="showToast('Product saved successfully!', 'success', { title: 'Success' })"
                class="px-6 py-3 bg-gradient-to-r from-teal-500 to-teal-600 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-200">
          Show Success Toast
        </button>
        
        <button onclick="showToast('Failed to save product', 'error', { title: 'Error' })"
                class="px-6 py-3 bg-gradient-to-r from-red-500 to-red-600 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-200">
          Show Error Toast
        </button>
        
        <button onclick="showToast('Please review your changes', 'warning', { title: 'Warning' })"
                class="px-6 py-3 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-200">
          Show Warning Toast
        </button>
        
        <button onclick="showToast('New features coming soon!', 'info', { title: 'Info' })"
                class="px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-200">
          Show Info Toast
        </button>
      </div>
    </div>

    <!-- Upvote Animation Demo -->
    <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6">🎊 Upvote Animation</h2>
      <p class="text-gray-600 mb-6">Click the upvote button to see the animation with confetti burst:</p>
      
      <div class="flex justify-center">
        <div data-controller="upvote-animation"
             data-action="click->upvote-animation#animate"
             data-upvote-animation-target="button"
             class="inline-flex flex-col items-center px-8 py-6 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border-2 border-gray-200 hover:from-red-50 hover:to-orange-50 hover:border-red-300 transition-all duration-300 shadow-md hover:shadow-lg cursor-pointer">
          <svg class="w-8 h-8 text-gray-600 hover:text-red-600 mb-2 transition-colors duration-200"
               fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"
               data-upvote-animation-target="icon">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
          </svg>
          <span class="text-3xl font-extrabold text-gray-900" data-upvote-animation-target="count">42</span>
          <span class="text-sm font-semibold text-gray-600 mt-1">Upvotes</span>
        </div>
      </div>
    </div>

    <!-- Card Hover Demo -->
    <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6">🎴 Card Hover Effects</h2>
      <p class="text-gray-600 mb-6">Hover over the card to see 3D tilt and glow effects:</p>
      
      <div class="flex justify-center">
        <div data-controller="card-hover"
             data-action="mouseenter->card-hover#mouseEnter mousemove->card-hover#mouseMove mouseleave->card-hover#mouseLeave click->card-hover#click"
             data-card-hover-target="card"
             class="w-80 h-64 bg-gradient-to-br from-red-600 via-blue-600 to-teal-500 rounded-2xl shadow-xl cursor-pointer card-hover-glow flex items-center justify-center">
          <div class="text-center text-white">
            <h3 class="text-2xl font-extrabold mb-2">Hover Me!</h3>
            <p class="text-sm opacity-90">Move your mouse around</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Skeleton Loader Demo -->
    <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6">💀 Skeleton Loader</h2>
      <p class="text-gray-600 mb-6">Click the button to see the skeleton loading animation:</p>
      
      <div class="mb-4">
        <button onclick="document.querySelector('[data-controller=skeleton-loader]').skeletonLoader.reload(); setTimeout(() => document.querySelector('[data-controller=skeleton-loader]').skeletonLoader.loaded(), 2000)"
                class="px-6 py-3 bg-gradient-to-r from-red-600 to-teal-600 text-white rounded-xl font-semibold shadow-md hover:shadow-lg transform hover:scale-105 transition-all duration-200">
          Reload Content
        </button>
      </div>
      
      <div data-controller="skeleton-loader" data-skeleton-loader-loaded-value="true">
        <div data-skeleton-loader-target="skeleton" class="hidden">
          <div class="animate-pulse">
            <div class="h-6 bg-gray-200 rounded-lg mb-4 skeleton" style="width: 70%;"></div>
            <div class="h-4 bg-gray-200 rounded-lg mb-2 skeleton" style="width: 90%;"></div>
            <div class="h-4 bg-gray-200 rounded-lg mb-2 skeleton" style="width: 80%;"></div>
            <div class="h-4 bg-gray-200 rounded-lg skeleton" style="width: 60%;"></div>
          </div>
        </div>
        <div data-skeleton-loader-target="content">
          <h3 class="text-xl font-bold text-gray-900 mb-2">Content Loaded!</h3>
          <p class="text-gray-600">This is the actual content that appears after loading.</p>
          <p class="text-gray-600">The skeleton loader provides a better user experience than a blank screen or spinner.</p>
        </div>
      </div>
    </div>

    <!-- Animation Classes Demo -->
    <div class="bg-white rounded-2xl shadow-lg p-8 mb-8">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6">✨ Utility Animations</h2>
      <p class="text-gray-600 mb-6">Various utility animations available throughout the app:</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Fade In -->
        <div class="p-6 bg-gradient-to-br from-red-50 to-orange-50 rounded-xl border border-red-200 animate-fade-in">
          <h4 class="font-bold text-red-900 mb-2">Fade In</h4>
          <p class="text-sm text-red-700">Smooth fade-in animation</p>
        </div>
        
        <!-- Bounce In -->
        <div class="p-6 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl border border-blue-200 animate-bounce-in">
          <h4 class="font-bold text-blue-900 mb-2">Bounce In</h4>
          <p class="text-sm text-blue-700">Bouncy entrance effect</p>
        </div>
        
        <!-- Glow Pulse -->
        <div class="p-6 bg-gradient-to-br from-teal-50 to-cyan-50 rounded-xl border border-teal-200 animate-glow-pulse">
          <h4 class="font-bold text-teal-900 mb-2">Glow Pulse</h4>
          <p class="text-sm text-teal-700">Pulsing glow effect</p>
        </div>
        
        <!-- Heartbeat -->
        <div class="p-6 bg-gradient-to-br from-pink-50 to-rose-50 rounded-xl border border-pink-200">
          <h4 class="font-bold text-pink-900 mb-2">Heartbeat</h4>
          <div class="text-4xl animate-heartbeat">❤️</div>
        </div>
        
        <!-- Rotate -->
        <div class="p-6 bg-gradient-to-br from-amber-50 to-yellow-50 rounded-xl border border-amber-200">
          <h4 class="font-bold text-amber-900 mb-2">Rotate</h4>
          <div class="text-4xl animate-rotate">⚙️</div>
        </div>
        
        <!-- Shake -->
        <div class="p-6 bg-gradient-to-br from-red-50 to-orange-50 rounded-xl border border-red-200">
          <h4 class="font-bold text-red-900 mb-2">Shake</h4>
          <button onclick="this.classList.add('animate-shake'); setTimeout(() => this.classList.remove('animate-shake'), 500)"
                  class="px-4 py-2 bg-red-600 text-white rounded-lg font-semibold">
            Click Me
          </button>
        </div>
      </div>
    </div>

    <!-- Color Palette -->
    <div class="bg-white rounded-2xl shadow-lg p-8">
      <h2 class="text-3xl font-extrabold text-gray-900 mb-6">🎨 Color Palette</h2>
      <p class="text-gray-600 mb-6">The Red-Blue-Teal color scheme used throughout AfriHunt:</p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Red -->
        <div class="text-center">
          <div class="w-full h-32 bg-gradient-to-br from-red-500 to-red-700 rounded-xl shadow-lg mb-4"></div>
          <h4 class="font-bold text-gray-900">Red</h4>
          <p class="text-sm text-gray-600">#dc2626</p>
          <p class="text-xs text-gray-500 mt-1">Energy, Passion, Primary CTAs</p>
        </div>
        
        <!-- Blue -->
        <div class="text-center">
          <div class="w-full h-32 bg-gradient-to-br from-blue-500 to-blue-700 rounded-xl shadow-lg mb-4"></div>
          <h4 class="font-bold text-gray-900">Blue</h4>
          <p class="text-sm text-gray-600">#2563eb</p>
          <p class="text-xs text-gray-500 mt-1">Trust, Professionalism, Links</p>
        </div>
        
        <!-- Teal -->
        <div class="text-center">
          <div class="w-full h-32 bg-gradient-to-br from-teal-500 to-teal-700 rounded-xl shadow-lg mb-4"></div>
          <h4 class="font-bold text-gray-900">Teal</h4>
          <p class="text-sm text-gray-600">#14b8a6</p>
          <p class="text-xs text-gray-500 mt-1">Innovation, Success, Verified</p>
        </div>
      </div>
      
      <!-- Gradient Example -->
      <div class="mt-8">
        <h4 class="font-bold text-gray-900 mb-4">Primary Gradient</h4>
        <div class="w-full h-24 bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 rounded-xl shadow-lg flex items-center justify-center">
          <span class="text-white text-2xl font-extrabold">from-red-600 via-blue-600 to-teal-500</span>
        </div>
      </div>
    </div>

    <!-- Back to Home -->
    <div class="text-center mt-12">
      <%= link_to root_path, class: "inline-flex items-center px-8 py-4 bg-gradient-to-r from-red-600 via-blue-600 to-teal-600 text-white rounded-xl font-bold shadow-lg hover:shadow-xl transform hover:scale-105 transition-all duration-200" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Home
      <% end %>
    </div>
  </div>
</div>

