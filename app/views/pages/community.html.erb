      <% end %>

      <%= link_to products_path, class: "inline-flex items-center justify-center px-10 py-5 border-2 border-white/30 rounded-xl text-xl font-bold text-white glass-effect hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 shadow-xl" do %>
        <svg class="w-7 h-7 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
