    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <% if user_signed_in? %>
        <%= link_to new_product_path, class: "group inline-flex items-center justify-center px-10 py-5 border-2 border-white rounded-xl text-xl font-bold text-red-600 bg-white hover:bg-red-50 transition-all duration-300 transform hover:-translate-y-1 shadow-2xl hover:shadow-3xl" do %>
