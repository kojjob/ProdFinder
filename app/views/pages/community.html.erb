<% content_for :title, "Community - AfriHunt" %>
<% content_for :meta_description, "Join the AfriHunt community of African makers, discover innovative products, and connect with fellow innovators across the continent." %>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 0.6; }
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes slide-in-left {
    from { opacity: 0; transform: translateX(-30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slide-in-right {
    from { opacity: 0; transform: translateX(30px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes scale-in {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  .animate-float { animation: float 6s ease-in-out infinite; }
  .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
  .animate-slide-up { animation: slide-up 0.8s ease-out forwards; }
  .animate-slide-in-left { animation: slide-in-left 0.8s ease-out forwards; }
  .animate-slide-in-right { animation: slide-in-right 0.8s ease-out forwards; }
  .animate-scale-in { animation: scale-in 0.6s ease-out forwards; }

  .glass-effect {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .text-gradient {
    background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hover-lift {
    transition: all 0.3s ease;
  }

  .hover-lift:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }
</style>

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-red-600 via-blue-600 to-teal-500 overflow-hidden">
  <!-- Animated Background Patterns -->
  <div class="absolute inset-0 opacity-20">
    <svg class="absolute top-20 left-10 w-64 h-64 text-white animate-float" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90,-16.3,88.5,-0.9C87,14.6,81.4,29.2,73.1,42.8C64.8,56.4,53.8,69,40.3,76.8C26.8,84.6,11.1,87.6,-4.8,85.9C-20.7,84.2,-41.4,77.8,-56.6,67.1C-71.8,56.4,-81.5,41.4,-85.6,25.1C-89.7,8.8,-88.2,-8.8,-82.3,-24.7C-76.4,-40.6,-66.1,-54.8,-53.1,-62.3C-40.1,-69.8,-24.4,-70.6,-9.3,-73.9C5.8,-77.2,30.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
    </svg>
    <svg class="absolute bottom-20 right-10 w-80 h-80 text-white animate-float" style="animation-delay: 1s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M39.5,-65.8C51.4,-58.1,61.3,-46.9,67.2,-33.9C73.1,-20.9,75,-6.1,73.2,8.2C71.4,22.5,65.9,36.3,56.8,47.1C47.7,57.9,35,65.7,21.2,69.8C7.4,73.9,-7.5,74.3,-21.6,70.5C-35.7,66.7,-49,58.7,-59.4,47.6C-69.8,36.5,-77.3,22.3,-78.9,7.3C-80.5,-7.7,-76.2,-23.5,-67.8,-36.8C-59.4,-50.1,-46.9,-60.9,-33.2,-67.9C-19.5,-74.9,-4.6,-78.1,8.9,-75.8C22.4,-73.5,27.6,-73.5,39.5,-65.8Z" transform="translate(100 100)" />
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <div class="text-center animate-slide-up">
      <!-- Badge -->
      <div class="inline-flex items-center px-4 py-2 rounded-full glass-effect mb-6">
        <svg class="w-5 h-5 text-yellow-300 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span class="text-white font-semibold text-sm">Africa's Largest Maker Community</span>
      </div>

      <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-white mb-6" style="letter-spacing: -0.02em;">
        Welcome to the <br class="hidden sm:block"/>
        <span class="inline-block mt-2">AfriHunt Community</span>
      </h1>

      <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto mb-10" style="font-weight: 300;">
        Connect with <%= number_with_delimiter(@total_makers) %> + makers, discover <%= number_with_delimiter(@total_products) %> + innovative products, and shape the future of African tech together.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <% if user_signed_in? %>
          <%= link_to new_product_path, class: "inline-flex items-center justify-center px-8 py-4 border-2 border-white rounded-xl text-lg font-bold text-red-600 bg-white hover:bg-red-50 transition-all duration-300 transform hover:-translate-y-1 shadow-2xl hover:shadow-3xl" do %>
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
            </svg>
            Launch Your Product
          <% end %>
        <% else %>
          <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center px-8 py-4 border-2 border-white rounded-xl text-lg font-bold text-red-600 bg-white hover:bg-red-50 transition-all duration-300 transform hover:-translate-y-1 shadow-2xl hover:shadow-3xl" do %>
            <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
            Join the Community
          <% end %>
        <% end %>

        <%= link_to products_path, class: "inline-flex items-center justify-center px-8 py-4 border-2 border-white/30 rounded-xl text-lg font-bold text-white glass-effect hover:bg-white/20 transition-all duration-300 transform hover:-translate-y-1 shadow-xl" do %>
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          Explore Products
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- Community Stats Bar -->
<section class="bg-white border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-6">
      <!-- Stat 1 -->
      <div class="text-center animate-scale-in" style="animation-delay: 0.1s;">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl mb-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
        </div>
        <p class="text-3xl font-extrabold text-gradient mb-1"><%= number_with_delimiter(@total_products) %></p>
        <p class="text-sm text-gray-600 font-semibold">Products</p>
      </div>

      <!-- Stat 2 -->
      <div class="text-center animate-scale-in" style="animation-delay: 0.2s;">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-2xl mb-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
          </svg>
        </div>
        <p class="text-3xl font-extrabold text-gradient mb-1"><%= number_with_delimiter(@total_makers) %></p>
        <p class="text-sm text-gray-600 font-semibold">Makers</p>
      </div>

      <!-- Stat 3 -->
      <div class="text-center animate-scale-in" style="animation-delay: 0.3s;">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-teal-500 to-teal-600 rounded-2xl mb-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"/>
          </svg>
        </div>
        <p class="text-3xl font-extrabold text-gradient mb-1"><%= number_with_delimiter(@total_upvotes) %></p>
        <p class="text-sm text-gray-600 font-semibold">Upvotes</p>
      </div>

      <!-- Stat 4 -->
      <div class="text-center animate-scale-in" style="animation-delay: 0.4s;">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-2xl mb-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <p class="text-3xl font-extrabold text-gradient mb-1"><%= @countries_count %></p>
        <p class="text-sm text-gray-600 font-semibold">Countries</p>
      </div>

      <!-- Stat 5 -->
      <div class="text-center animate-scale-in" style="animation-delay: 0.5s;">
        <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-yellow-500 to-orange-600 rounded-2xl mb-3 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
          </svg>
        </div>
        <p class="text-3xl font-extrabold text-gradient mb-1"><%= number_with_delimiter(@total_collections) %></p>
        <p class="text-sm text-gray-600 font-semibold">Collections</p>
      </div>
    </div>
  </div>
</section>

<!-- Featured Makers Section -->
<% if @featured_makers.any? %>
<section class="py-16 bg-gradient-to-br from-gray-50 to-red-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 animate-slide-up">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4" style="letter-spacing: -0.02em;">
        Featured <span class="text-gradient">Makers</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Meet the top innovators building amazing products across Africa
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-6">
      <% @featured_makers.each_with_index do |maker, index| %>
        <%= link_to user_path(maker), class: "group" do %>
          <div class="text-center animate-scale-in" style="animation-delay: <%= index * 0.05 %>s;">
            <div class="relative mb-3">
              <% if maker.read_attribute(:avatar_url).present? %>
                <%= image_tag maker.read_attribute(:avatar_url), alt: maker.full_name, class: "w-20 h-20 rounded-full mx-auto object-cover border-4 border-white shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:scale-110" %>
              <% else %>
                <div class="w-20 h-20 rounded-full mx-auto bg-gradient-to-br from-red-500 to-teal-600 flex items-center justify-center border-4 border-white shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:scale-110">
                  <span class="text-white text-2xl font-bold"><%= maker.full_name.first.upcase %></span>
                </div>
              <% end %>
              <% if maker.verified %>
                <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-red-500 rounded-full flex items-center justify-center border-2 border-white">
                  <svg class="w-3 h-3 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                </div>
              <% end %>
            </div>
            <p class="font-bold text-gray-900 text-sm group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-300 truncate">
              <%= maker.full_name %>
            </p>
            <p class="text-xs text-gray-500 mt-1"><%= maker.followers_count %> followers</p>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
<% end %>


<!-- Trending Products Section -->
<% if @trending_products.any? %>
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-12 animate-slide-up">
      <div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-2" style="letter-spacing: -0.02em;">
          🔥 Trending <span class="text-gradient">This Week</span>
        </h2>
        <p class="text-lg text-gray-600">
          The hottest products gaining traction in the community
        </p>
      </div>
      <%= link_to products_path, class: "hidden md:inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-bold hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1" do %>
        View All Products
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @trending_products.each_with_index do |product, index| %>
        <%= link_to product_path(product), class: "group" do %>
          <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 animate-slide-up" style="animation-delay: <%= index * 0.1 %>s;">
            <!-- Product Header -->
            <div class="p-6">
              <div class="flex items-start gap-4 mb-4">
                <div class="w-16 h-16 bg-gradient-to-br from-red-500 to-teal-600 rounded-xl flex items-center justify-center flex-shrink-0 shadow-md">
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-xl font-extrabold text-gray-900 mb-1 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-300 truncate">
                    <%= product.name %>
                  </h3>
                  <p class="text-sm text-gray-600 line-clamp-2">
                    <%= product.tagline %>
                  </p>
                </div>
              </div>

              <!-- Product Stats -->
              <div class="flex items-center gap-4 mb-4">
                <div class="flex items-center gap-1 text-sm">
                  <svg class="w-4 h-4 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/>
                  </svg>
                  <span class="font-bold text-gray-900"><%= product.upvotes_count %></span>
                </div>
                <div class="flex items-center gap-1 text-sm">
                  <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                  <span class="font-bold text-gray-900"><%= product.comments_count %></span>
                </div>
                <div class="ml-auto">
                  <span class="px-3 py-1 bg-gradient-to-r from-orange-100 to-red-100 text-orange-700 rounded-full text-xs font-bold">
                    🔥 Trending
                  </span>
                </div>
              </div>

              <!-- Topics -->
              <% if product.topics.any? %>
                <div class="flex flex-wrap gap-2">
                  <% product.topics.first(3).each do |topic| %>
                    <span class="px-2 py-1 bg-red-50 text-red-600 rounded-md text-xs font-semibold">
                      <%= topic.name %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<!-- Recent Products Section -->
<% if @recent_products.any? %>
<section class="py-16 bg-gradient-to-br from-gray-50 to-blue-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-12 animate-slide-up">
      <div>
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-2" style="letter-spacing: -0.02em;">
          ✨ Recently <span class="text-gradient">Launched</span>
        </h2>
        <p class="text-lg text-gray-600">
          Fresh products just added to the community
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% @recent_products.each_with_index do |product, index| %>
        <%= link_to product_path(product), class: "group" do %>
          <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 animate-slide-up" style="animation-delay: <%= index * 0.1 %>s;">
            <div class="p-6">
              <div class="flex items-start gap-4 mb-4">
                <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-600 rounded-xl flex items-center justify-center flex-shrink-0 shadow-md">
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-xl font-extrabold text-gray-900 mb-1 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-purple-600 group-hover:to-pink-600 group-hover:bg-clip-text transition-all duration-300 truncate">
                    <%= product.name %>
                  </h3>
                  <p class="text-sm text-gray-600 line-clamp-2">
                    <%= product.tagline %>
                  </p>
                </div>
              </div>

              <!-- Makers -->
              <% if product.makers.any? %>
                <div class="flex items-center gap-2 mb-4">
                  <span class="text-xs text-gray-500">by</span>
                  <div class="flex -space-x-2">
                    <% product.makers.first(3).each do |maker| %>
                      <% if maker.read_attribute(:avatar_url).present? %>
                        <%= image_tag maker.read_attribute(:avatar_url), alt: maker.full_name, class: "w-6 h-6 rounded-full border-2 border-white" %>
                      <% else %>
                        <div class="w-6 h-6 rounded-full border-2 border-white bg-gradient-to-br from-red-500 to-teal-600 flex items-center justify-center">
                          <span class="text-white text-xs font-bold"><%= maker.full_name.first.upcase %></span>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                  <span class="text-xs font-semibold text-gray-700">
                    <%= product.makers.first.full_name %>
                    <% if product.makers.count > 1 %>
                      +<%= product.makers.count - 1 %>
                    <% end %>
                  </span>
                </div>
              <% end %>

              <!-- Stats & Badge -->
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3 text-sm">
                  <div class="flex items-center gap-1">
                    <svg class="w-4 h-4 text-pink-500" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z"/>
                    </svg>
                    <span class="font-bold text-gray-900"><%= product.upvotes_count %></span>
                  </div>
                </div>
                <span class="px-3 py-1 bg-gradient-to-r from-green-100 to-emerald-100 text-green-700 rounded-full text-xs font-bold">
                  ✨ New
                </span>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</section>
<% end %>


<!-- Popular Topics Section -->
<% if @popular_topics.any? %>
<section class="py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 animate-slide-up">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4" style="letter-spacing: -0.02em;">
        Explore by <span class="text-gradient">Topic</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Discover products across different categories and technologies
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-4">
      <% @popular_topics.each_with_index do |topic, index| %>
        <%= link_to topic_path(topic), class: "group" do %>
          <div class="bg-gradient-to-br from-gray-50 to-red-50 rounded-xl p-6 text-center hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 border border-gray-200/50 animate-scale-in" style="animation-delay: <%= index * 0.05 %>s;">
            <% if topic.icon.present? %>
              <div class="text-4xl mb-3"><%= topic.icon %></div>
            <% else %>
              <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-teal-600 rounded-xl flex items-center justify-center mx-auto mb-3 shadow-md">
                <span class="text-white text-xl font-bold">#</span>
              </div>
            <% end %>
            <h3 class="font-extrabold text-gray-900 text-sm mb-1 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-300">
              <%= topic.name %>
            </h3>
            <p class="text-xs text-gray-500">
              <%= pluralize(topic.products_count, 'product') %>
            </p>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="text-center mt-10">
      <%= link_to topics_path, class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-bold hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1" do %>
        View All Topics
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<!-- Recent Activity Section -->
<% if @recent_comments.any? %>
<section class="py-16 bg-gradient-to-br from-gray-50 to-teal-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12 animate-slide-up">
      <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4" style="letter-spacing: -0.02em;">
        💬 Recent <span class="text-gradient">Activity</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        See what the community is talking about
      </p>
    </div>

    <div class="max-w-4xl mx-auto space-y-4">
      <% @recent_comments.first(5).each_with_index do |comment, index| %>
        <div class="bg-white rounded-xl shadow-md border border-gray-200/50 p-6 hover:shadow-lg transition-all duration-300 animate-slide-up" style="animation-delay: <%= index * 0.05 %>s;">
          <div class="flex items-start gap-4">
            <!-- User Avatar -->
            <%= link_to user_path(comment.user), class: "flex-shrink-0" do %>
              <% if comment.user.read_attribute(:avatar_url).present? %>
                <%= image_tag comment.user.read_attribute(:avatar_url), alt: comment.user.full_name, class: "w-12 h-12 rounded-full object-cover border-2 border-white shadow-md hover:shadow-lg transition-shadow duration-200" %>
              <% else %>
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-red-500 to-teal-600 flex items-center justify-center shadow-md hover:shadow-lg transition-shadow duration-200">
                  <span class="text-white text-sm font-bold"><%= comment.user.full_name.first.upcase %></span>
                </div>
              <% end %>
            <% end %>

            <!-- Comment Content -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-2">
                <%= link_to user_path(comment.user), class: "font-bold text-gray-900 hover:text-red-600 transition-colors duration-200" do %>
                  <%= comment.user.full_name %>
                <% end %>
                <% if comment.user.verified %>
                  <svg class="w-4 h-4 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                <% end %>
                <span class="text-gray-500">•</span>
                <span class="text-sm text-gray-500"><%= time_ago_in_words(comment.created_at) %> ago</span>
              </div>

              <p class="text-gray-700 mb-3 leading-relaxed">
                <%= comment.content %>
              </p>

              <%= link_to product_path(comment.product), class: "inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-red-50 to-orange-50 rounded-lg hover:from-blue-100 hover:to-purple-100 transition-all duration-200 group" do %>
                <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-teal-600 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                  </svg>
                </div>
                <div class="text-left">
                  <p class="text-sm font-bold text-gray-900 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-200">
                    <%= comment.product.name %>
                  </p>
                  <p class="text-xs text-gray-600">View product</p>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<!-- Final CTA Section -->
<section class="py-20 bg-gradient-to-br from-red-600 via-blue-600 to-teal-500 relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <svg class="absolute top-10 right-10 w-64 h-64 text-white animate-float" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
      <path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90,-16.3,88.5,-0.9C87,14.6,81.4,29.2,73.1,42.8C64.8,56.4,53.8,69,40.3,76.8C26.8,84.6,11.1,87.6,-4.8,85.9C-20.7,84.2,-41.4,77.8,-56.6,67.1C-71.8,56.4,-81.5,41.4,-85.6,25.1C-89.7,8.8,-88.2,-8.8,-82.3,-24.7C-76.4,-40.6,-66.1,-54.8,-53.1,-62.3C-40.1,-69.8,-24.4,-70.6,-9.3,-73.9C5.8,-77.2,30.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
    </svg>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-6" style="letter-spacing: -0.02em;">
      Ready to Join the Community?
