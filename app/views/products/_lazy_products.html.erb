<div data-controller="lazy-load" data-lazy-load-url-value="<%= products_path(page: params[:page] || 1) %>" data-lazy-load-loaded-value="false">
  <div data-lazy-load-target="placeholder" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <!-- Loading placeholders -->
    <% 6.times do |i| %>
      <div class="animate-pulse">
        <div class="bg-white rounded-2xl shadow-md border border-gray-200/50 overflow-hidden">
          <div class="p-6 h-full flex flex-col">
            <div class="flex items-start justify-between mb-4">
              <div class="flex-1 min-w-0">
                <div class="h-6 bg-gray-200 rounded mb-2"></div>
                <div class="h-4 bg-gray-200 rounded w-3/4"></div>
              </div>
              <div class="ml-4 flex-shrink-0">
                <div class="w-16 h-16 bg-gray-200 rounded-xl"></div>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 mb-4">
              <% 3.times do %>
                <div class="h-6 bg-gray-200 rounded-lg w-20"></div>
              <% end %>
            </div>
            <div class="flex-grow"></div>
            <div class="flex items-center justify-between pt-4 mt-4 border-t border-gray-100">
              <div class="flex items-center">
                <div class="w-7 h-7 bg-gray-200 rounded-full"></div>
                <div class="ml-2 h-4 bg-gray-200 rounded w-24"></div>
              </div>
              <div class="h-4 bg-gray-200 rounded w-16"></div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div data-lazy-load-target="content" class="hidden">
    <!-- Content will be loaded here -->
  </div>
  <div data-lazy-load-target="trigger" class="h-10"></div>
</div>
