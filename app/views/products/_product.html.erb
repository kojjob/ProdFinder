<%= content_tag :div, id: "product_#{product.id}", class: "h-full" do %>
  <div class="bg-white rounded-lg border border-gray-200 p-6 hover:border-gray-300 hover:shadow-md transition-all duration-200 h-full flex flex-col">
    <%= link_to product_path(product), class: "group flex-1 flex flex-col", data: { turbo: false } do %>
      <div class="flex-1 flex flex-col">
        <!-- Header -->
        <div class="flex items-start justify-between mb-4">
          <div class="flex-1 min-w-0">
            <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors truncate">
              <%= product.name %>
            </h3>
            <p class="text-gray-600 text-sm leading-relaxed line-clamp-2">
              <%= truncate(product.tagline, length: 100) %>
            </p>
          </div>
        </div>
        <!-- Topics -->
        <% if product.topics.any? %>
          <div class="flex flex-wrap gap-2 mb-4">
            <% product.topics.first(3).each do |topic| %>
              <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-gray-100 text-gray-700">
                <% if topic.icon.present? %>
                  <span class="mr-1"><%= topic.icon %></span>
                <% end %>
                <%= topic.name %>
              </span>
            <% end %>
          </div>
        <% end %>
        <!-- Spacer -->
        <div class="flex-grow"></div>
        <!-- Footer -->
        <div class="flex items-center justify-between pt-4 mt-4 border-t border-gray-100">
          <div class="flex items-center min-w-0 flex-1">
            <% if product.makers.any? %>
              <div class="w-6 h-6 rounded-full bg-gray-300 flex items-center justify-center flex-shrink-0">
                <span class="text-white text-xs font-medium"><%= product.makers.first.full_name.first %></span>
              </div>
              <span class="ml-2 text-sm text-gray-600 truncate">
                <%= product.makers.first.full_name %>
              </span>
            <% end %>
          </div>
          <div class="flex items-center text-sm text-gray-500 ml-4 flex-shrink-0">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
            <span><%= product.comments_count %></span>
          </div>
        </div>
      </div>
    <% end %>
    <!-- Upvote Button -->
    <div class="mt-4 pt-4 border-t border-gray-100">
      <%= turbo_frame_tag "upvote_#{product.id}" do %>
        <% if current_user&.upvoted?(product) %>
          <%= button_to toggle_upvote_product_path(product),
              class: "w-full flex items-center justify-center px-3 py-2 text-sm font-medium text-amber-600 hover:text-amber-700 transition-colors",
              form: { data: { turbo_frame: "upvote_#{product.id}" } } do %>
            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M3.293 9.707a1 1 0 010-1.414l6-6a1 1 0 011.414 0l6 6a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L4.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
            </svg>
            <%= product.upvotes_count %> upvotes
          <% end %>
        <% else %>
          <%= button_to toggle_upvote_product_path(product),
              class: "w-full flex items-center justify-center px-3 py-2 text-sm font-medium text-gray-500 hover:text-amber-600 transition-colors",
              form: { data: { turbo_frame: "upvote_#{product.id}" } } do %>
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 20 20">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
            </svg>
            <%= product.upvotes_count %> upvotes
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
