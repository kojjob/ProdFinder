<%= content_tag :div, id: "product_#{product.id}", class: "h-full animate-slide-up", style: "animation-delay: #{(index % 12) * 0.05}s;" do %>
  <div class="relative h-full"
       data-controller="card-hover"
       data-action="mouseenter->card-hover#mouseEnter mousemove->card-hover#mouseMove mouseleave->card-hover#mouseLeave click->card-hover#click">
    <%= link_to product_path(product), class: "group", data: { turbo: false } do %>
      <div class="relative h-full bg-white rounded-2xl shadow-md border border-gray-200/50 overflow-hidden hover:shadow-xl transition-all duration-300 card-hover-glow group-hover:border-transparent"
           data-card-hover-target="card">
        <!-- Gradient Border on Hover -->
        <div class="absolute inset-0 bg-gradient-to-br from-red-600 via-blue-600 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl" style="padding: 2px;">
          <div class="h-full w-full bg-white rounded-2xl"></div>
        </div>
        <div class="relative p-6 h-full flex flex-col">
          <!-- Header -->
          <div class="flex items-start justify-between mb-4">
            <div class="flex-1 min-w-0">
              <h3 class="text-xl font-extrabold text-gray-900 mb-2 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-red-600 group-hover:via-blue-600 group-hover:to-teal-600 group-hover:bg-clip-text transition-all duration-300 truncate" style="letter-spacing: -0.01em;">
                <%= product.name %>
              </h3>
              <p class="text-gray-600 text-sm leading-relaxed line-clamp-2 min-h-[2.5rem]">
                <%= truncate(product.tagline, length: 100) %>
              </p>
            </div>
            <!-- Upvote Button with Turbo Frame -->
            <div class="ml-4 flex-shrink-0">
              <%= turbo_frame_tag "upvote_#{product.id}" do %>
                <% upvoted = current_user&.upvoted?(product) %>
                <%= button_to toggle_upvote_product_path(product), method: :post, class: "upvote-button-container" do %>
  <div class="upvote-button">
    <span class="upvote-arrow">▲</span>
    <span class="upvote-count"><%= product.upvotes_count %></span>
  </div>
<% end %>
              <% end %>
            </div>
          </div>
          <!-- Topics -->
          <div class="flex flex-wrap gap-2 mb-4">
            <% product.topics.first(3).each do |topic| %>
              <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-semibold bg-gradient-to-r from-gray-100 to-gray-50 text-gray-700 border border-gray-200 hover:border-gray-300 transition-colors duration-200">
                <% if topic.icon.present? %>
                  <span class="mr-1.5"><%= topic.icon %></span>
                <% end %>
                <%= topic.name %>
              </span>
            <% end %>
          </div>
          <!-- Spacer -->
          <div class="flex-grow"></div>
          <!-- Footer -->
          <div class="flex items-center justify-between pt-4 mt-4 border-t border-gray-100">
            <div class="flex items-center min-w-0 flex-1">
              <div class="w-7 h-7 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-sm flex-shrink-0">
                <span class="text-white text-xs font-bold"><%= product.makers.first.full_name.first if product.makers.any? %></span>
              </div>
              <span class="ml-2 text-sm font-semibold text-gray-700 truncate">
                <%= product.makers.first.full_name if product.makers.any? %>
              </span>
            </div>
            <div class="flex items-center space-x-4 text-sm text-gray-500 ml-4 flex-shrink-0">
              <div class="flex items-center">
                <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
                <span class="font-semibold"><%= product.comments_count %></span>
              </div>
            </div>
          </div>
        </div>
        <!-- Hover Indicator -->
        <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transform scale-75 group-hover:scale-100 transition-all duration-300">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-lg">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </div>
        </div>
        <!-- Quick View Button -->
        <div class="absolute bottom-4 right-4 opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300">
          <%= link_to quick_view_product_path(product), 
              class: "inline-flex items-center px-4 py-2 bg-white/90 backdrop-blur-sm text-gray-800 rounded-lg text-sm font-semibold shadow-lg hover:bg-white hover:shadow-xl transition-all duration-200",
              data: { turbo: true } do %>
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
            Quick View
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
