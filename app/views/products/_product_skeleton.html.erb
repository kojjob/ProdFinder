<!-- Product Card Skeleton Loader -->
<div class="h-full animate-pulse">
  <div class="relative h-full bg-white rounded-2xl shadow-md border border-gray-200/50 p-6">
    <!-- Header Skeleton -->
    <div class="flex items-start justify-between mb-4">
      <div class="flex-1 min-w-0">
        <!-- Title Skeleton -->
        <div class="h-6 bg-gray-200 rounded-lg mb-2 skeleton" style="width: 70%;"></div>
        <!-- Tagline Skeleton -->
        <div class="h-4 bg-gray-200 rounded-lg skeleton" style="width: 90%;"></div>
        <div class="h-4 bg-gray-200 rounded-lg mt-1 skeleton" style="width: 60%;"></div>
      </div>
      <!-- Upvote Button Skeleton -->
      <div class="ml-4 flex-shrink-0">
        <div class="flex flex-col items-center px-4 py-3 bg-gray-100 rounded-xl border border-gray-200 w-16 h-20">
          <div class="w-5 h-5 bg-gray-200 rounded skeleton mb-1"></div>
          <div class="w-8 h-5 bg-gray-200 rounded skeleton"></div>
        </div>
      </div>
    </div>
    
    <!-- Topics Skeleton -->
    <div class="flex flex-wrap gap-2 mb-4">
      <div class="h-6 w-20 bg-gray-200 rounded-lg skeleton"></div>
      <div class="h-6 w-24 bg-gray-200 rounded-lg skeleton"></div>
      <div class="h-6 w-16 bg-gray-200 rounded-lg skeleton"></div>
    </div>
    
    <!-- Image Skeleton -->
    <div class="w-full h-48 bg-gray-200 rounded-xl mb-4 skeleton"></div>
    
    <!-- Makers Skeleton -->
    <div class="flex items-center gap-2 mb-4">
      <div class="w-8 h-8 bg-gray-200 rounded-full skeleton"></div>
      <div class="h-4 w-32 bg-gray-200 rounded skeleton"></div>
    </div>
    
    <!-- Footer Skeleton -->
    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
      <div class="flex items-center gap-4">
        <div class="h-4 w-16 bg-gray-200 rounded skeleton"></div>
        <div class="h-4 w-16 bg-gray-200 rounded skeleton"></div>
      </div>
      <div class="h-4 w-20 bg-gray-200 rounded skeleton"></div>
    </div>
  </div>
</div>

