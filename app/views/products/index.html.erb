<% content_for :title, "Products - AfriHunt" %>
<div class="min-h-screen bg-gray-50">
  <!-- Header Section -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-light text-gray-900 mb-4">
          Discover Products
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed">
          Explore innovative products built by African makers and entrepreneurs
        </p>
      </div>
    </div>
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Product of the Day -->
    <% if @product_of_day.present? %>
      <div class="mb-12">
        <div class="flex items-center mb-6">
          <svg class="w-5 h-5 text-amber-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <h2 class="text-lg font-medium text-gray-900">Product of the Day</h2>
        </div>
        <%= link_to product_path(@product_of_day), class: "block group" do %>
          <div class="bg-white rounded-lg border border-gray-200 p-6 hover:border-gray-300 hover:shadow-md transition-all duration-200">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <div class="flex items-center mb-2">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-amber-100 text-amber-800">
                    Featured
                  </span>
                </div>
                <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                  <%= @product_of_day.name %>
                </h3>
                <p class="text-gray-600 mb-4 line-clamp-2">
                  <%= @product_of_day.tagline %>
                </p>
                <div class="flex items-center text-sm text-gray-500">
                  <% if @product_of_day.makers.any? %>
                    <span>by <%= @product_of_day.makers.first.full_name %></span>
                  <% end %>
                  <span class="mx-2">•</span>
                  <span><%= @product_of_day.upvotes_count %> upvotes</span>
                </div>
              </div>
              <div class="ml-6 flex flex-col items-center">
                <%= turbo_frame_tag "upvote_#{@product_of_day.id}" do %>
                  <% if current_user&.upvoted?(@product_of_day) %>
                    <%= button_to toggle_upvote_product_path(@product_of_day),
                        class: "flex flex-col items-center p-3 text-amber-600 hover:text-amber-700 transition-colors",
                        form: { data: { turbo_frame: "upvote_#{@product_of_day.id}" } } do %>
                      <svg class="w-5 h-5 mb-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.293 9.707a1 1 0 010-1.414l6-6a1 1 0 011.414 0l6 6a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L4.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-sm font-medium"><%= @product_of_day.upvotes_count %></span>
                    <% end %>
                  <% else %>
                    <%= button_to toggle_upvote_product_path(@product_of_day),
                        class: "flex flex-col items-center p-3 text-gray-400 hover:text-amber-600 transition-colors",
                        form: { data: { turbo_frame: "upvote_#{@product_of_day.id}" } } do %>
                      <svg class="w-5 h-5 mb-1" fill="none" stroke="currentColor" viewBox="0 0 20 20">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                      <span class="text-sm font-medium"><%= @product_of_day.upvotes_count %></span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <!-- Featured Products -->
    <% if @featured_products.any? %>
      <div class="mb-12">
        <h2 class="text-lg font-medium text-gray-900 mb-6">Featured Products</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <% @featured_products.each_with_index do |product, index| %>
            <%= link_to product_path(product), class: "group" do %>
              <div class="bg-white rounded-lg border border-gray-200 p-6 hover:border-gray-300 hover:shadow-md transition-all duration-200">
                <div class="flex items-start justify-between mb-4">
                  <span class="inline-flex items-center px-2 py-1 rounded text-xs font-medium bg-blue-100 text-blue-800">
                    Featured
                  </span>
                  <div class="text-sm text-gray-500">
                    <%= product.upvotes_count %> ↑
                  </div>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                  <%= product.name %>
                </h3>
                <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                  <%= product.tagline %>
                </p>
                <div class="flex items-center text-sm text-gray-500">
                  <% if product.makers.any? %>
                    <span>by <%= product.makers.first.full_name %></span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <!-- Filter Bar -->
    <div class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h2 class="text-lg font-medium text-gray-900">All Products</h2>
          <p class="text-sm text-gray-500"><%= @products.total_count %> products</p>
        </div>
        <div class="flex items-center gap-3">
          <button class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
            </svg>
            Filter
          </button>
          <select class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
            <option>Most Recent</option>
            <option>Most Upvoted</option>
            <option>Most Discussed</option>
          </select>
        </div>
      </div>
    </div>
    <!-- Products Grid -->
    <% if @products.any? %>
      <div id="products-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        <% @products.each_with_index do |product, index| %>
          <%= render 'products/product', product: product, index: index %>
        <% end %>
      </div>
      <!-- Pagination -->
      <div class="flex justify-center">
        <%= paginate @products %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-16">
        <div class="max-w-md mx-auto">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No products yet</h3>
          <p class="text-gray-500 mb-6">Be the first to share your product with the community.</p>
          <% if user_signed_in? %>
            <%= link_to "Launch Product", new_product_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <% else %>
            <%= link_to "Sign Up", new_user_registration_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
