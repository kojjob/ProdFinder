<% content_for :title, "Discover African Innovation - Products - AfriHunt" %>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-float { animation: float 6s ease-in-out infinite; }
  .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
  .animate-slide-up { animation: slide-up 0.6s ease-out forwards; }

  .glass-effect {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .gradient-border {
    position: relative;
    background: white;
  }

  .gradient-border::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6, #ec4899);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gradient-border:hover::before {
    opacity: 1;
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-purple-50/30">
  <!-- Hero Section with Enhanced Design -->
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-600 via-purple-600 to-pink-500 text-white">
    <!-- Animated Background Patterns -->
    <div class="absolute inset-0 opacity-20">
      <svg class="absolute top-10 left-10 w-32 h-32 text-white animate-float" style="animation-delay: 0s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90,-16.3,88.5,-0.9C87,14.6,81.4,29.2,73.1,42.8C64.8,56.4,53.8,69,40.3,76.8C26.8,84.6,11.1,87.6,-4.8,85.9C-20.7,84.2,-41.4,77.8,-56.6,67.1C-71.8,56.4,-81.5,41.4,-85.6,25.1C-89.7,8.8,-88.2,-8.8,-82.3,-24.7C-76.4,-40.6,-66.1,-54.8,-53.1,-62.3C-40.1,-69.8,-24.4,-70.6,-9.3,-73.9C5.8,-77.2,30.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
      </svg>
      <svg class="absolute top-40 right-20 w-40 h-40 text-white animate-float" style="animation-delay: 1s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M39.5,-65.5C51.4,-58.3,61.3,-47.6,68.4,-35.2C75.5,-22.8,79.8,-8.7,79.3,5.3C78.8,19.3,73.5,33.2,65.1,45.3C56.7,57.4,45.2,67.7,32.1,73.4C19,79.1,4.3,80.2,-10.3,77.8C-24.9,75.4,-39.4,69.5,-51.8,60.3C-64.2,51.1,-74.5,38.6,-78.9,24.5C-83.3,10.4,-81.8,-5.3,-76.2,-19.4C-70.6,-33.5,-60.9,-46,-48.8,-53.6C-36.7,-61.2,-22.2,-63.9,-8.3,-66.8C5.6,-69.7,27.6,-72.7,39.5,-65.5Z" transform="translate(100 100)" />
      </svg>
      <svg class="absolute bottom-20 left-1/4 w-36 h-36 text-white animate-float" style="animation-delay: 2s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M47.3,-78.7C61.1,-71.4,72.1,-58.3,78.9,-43.5C85.7,-28.7,88.3,-12.2,86.6,3.7C84.9,19.6,78.9,34.9,69.8,47.8C60.7,60.7,48.5,71.2,34.6,76.8C20.7,82.4,5.1,83.1,-10.2,80.3C-25.5,77.5,-40.5,71.2,-53.3,61.8C-66.1,52.4,-76.7,39.9,-81.8,25.5C-86.9,11.1,-86.5,-5.2,-81.3,-19.9C-76.1,-34.6,-66.1,-47.7,-53.8,-55.3C-41.5,-62.9,-26.9,-64.9,-12.8,-68.4C1.3,-71.9,33.5,-86,47.3,-78.7Z" transform="translate(100 100)" />
      </svg>
    </div>

    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="text-center">
        <!-- Badge -->
        <div class="inline-flex items-center px-4 py-2 rounded-full glass-effect mb-6 animate-slide-up">
          <svg class="w-5 h-5 mr-2 text-yellow-300" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span class="text-sm font-semibold tracking-wide">Africa's Premier Product Discovery Platform</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 animate-slide-up" style="animation-delay: 0.1s; letter-spacing: -0.02em; line-height: 1.1;">
          Discover African
          <span class="block mt-2 bg-gradient-to-r from-yellow-300 via-pink-300 to-purple-300 bg-clip-text text-transparent">
            Innovation
          </span>
        </h1>

        <p class="text-xl md:text-2xl text-blue-100 mb-10 max-w-3xl mx-auto leading-relaxed animate-slide-up" style="animation-delay: 0.2s; font-weight: 300; letter-spacing: 0.01em;">
          The best new products built for and by Africa. Discover, upvote, and support the next generation of African makers.
        </p>

        <!-- Enhanced Search Bar -->
        <div class="max-w-3xl mx-auto animate-slide-up" style="animation-delay: 0.3s;">
          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-pink-400 via-purple-400 to-blue-400 rounded-2xl blur-lg opacity-50 group-hover:opacity-75 transition duration-500 animate-pulse-glow"></div>
            <div class="relative">
              <input
                type="text"
                placeholder="Search products, makers, or topics..."
                class="w-full px-8 py-5 pr-14 rounded-2xl text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-4 focus:ring-white/50 shadow-2xl text-lg font-medium transition-all duration-300"
                style="letter-spacing: 0.01em;"
              />
              <button class="absolute right-4 top-1/2 transform -translate-y-1/2 p-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl hover:from-blue-700 hover:to-purple-700 transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="mt-12 flex flex-wrap justify-center gap-8 text-center animate-slide-up" style="animation-delay: 0.4s;">
          <div class="glass-effect px-6 py-3 rounded-xl">
            <div class="text-3xl font-bold text-white"><%= Product.live.count %></div>
            <div class="text-sm text-blue-200 font-medium tracking-wide">Products</div>
          </div>
          <div class="glass-effect px-6 py-3 rounded-xl">
            <div class="text-3xl font-bold text-white"><%= User.count %></div>
            <div class="text-sm text-blue-200 font-medium tracking-wide">Makers</div>
          </div>
          <div class="glass-effect px-6 py-3 rounded-xl">
            <div class="text-3xl font-bold text-white">54</div>
            <div class="text-sm text-blue-200 font-medium tracking-wide">Countries</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Product of the Day -->
    <% if @product_of_day.present? %>
      <div class="mb-16">
        <div class="flex items-center justify-center mb-8">
          <div class="relative inline-flex items-center">
            <div class="absolute -inset-2 bg-gradient-to-r from-yellow-400 via-orange-400 to-pink-400 rounded-full blur-xl opacity-30 animate-pulse-glow"></div>
            <svg class="relative w-10 h-10 text-yellow-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <h2 class="relative text-4xl font-extrabold bg-gradient-to-r from-yellow-600 via-orange-600 to-pink-600 bg-clip-text text-transparent" style="letter-spacing: -0.01em;">
              Product of the Day
            </h2>
          </div>
        </div>

        <%= link_to product_path(@product_of_day), class: "block group" do %>
          <div class="relative">
            <!-- Glow Effect -->
            <div class="absolute -inset-1 bg-gradient-to-r from-yellow-400 via-orange-400 to-pink-400 rounded-3xl blur-2xl opacity-20 group-hover:opacity-30 transition duration-500"></div>

            <!-- Card -->
            <div class="relative bg-gradient-to-br from-yellow-50 via-orange-50 to-pink-50 rounded-3xl shadow-2xl border-2 border-yellow-200/50 overflow-hidden group-hover:shadow-3xl transition-all duration-500 transform group-hover:-translate-y-2">
              <!-- Decorative Elements -->
              <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-yellow-200/30 to-transparent rounded-full blur-3xl"></div>
              <div class="absolute bottom-0 left-0 w-48 h-48 bg-gradient-to-tr from-orange-200/30 to-transparent rounded-full blur-3xl"></div>

              <div class="relative p-10">
                <div class="flex items-start justify-between gap-8">
                  <div class="flex-1">
                    <!-- Badge -->
                    <div class="inline-flex items-center px-5 py-2 rounded-full text-sm font-bold bg-gradient-to-r from-yellow-500 to-orange-500 text-white shadow-lg mb-6">
                      <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                      <span class="tracking-wide">#1 Product of the Day</span>
                    </div>

                    <h3 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-300" style="letter-spacing: -0.02em; line-height: 1.2;">
                      <%= @product_of_day.name %>
                    </h3>

                    <p class="text-2xl text-gray-700 mb-6 leading-relaxed font-medium" style="letter-spacing: 0.01em;">
                      <%= @product_of_day.tagline %>
                    </p>

                    <p class="text-lg text-gray-600 mb-8 leading-relaxed">
                      <%= truncate(@product_of_day.description, length: 250) %>
                    </p>

                    <!-- Makers -->
                    <div class="flex items-center mb-6">
                      <span class="text-sm font-semibold text-gray-500 mr-4 tracking-wide uppercase">Created by</span>
                      <div class="flex items-center -space-x-3">
                        <% @product_of_day.makers.first(3).each do |maker| %>
                          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 border-3 border-white shadow-lg flex items-center justify-center transform hover:scale-110 transition-transform duration-200" title="<%= maker.full_name %>">
                            <span class="text-white text-sm font-bold"><%= maker.full_name.first %></span>
                          </div>
                        <% end %>
                      </div>
                      <span class="ml-4 text-base font-bold text-gray-800">
                        <%= @product_of_day.makers.first.full_name %>
                        <% if @product_of_day.makers.count > 1 %>
                          <span class="text-gray-500 font-normal">+ <%= @product_of_day.makers.count - 1 %> more</span>
                        <% end %>
                      </span>
                    </div>

                    <!-- Topics -->
                    <div class="flex flex-wrap gap-3">
                      <% @product_of_day.topics.first(4).each do |topic| %>
                        <span class="inline-flex items-center px-4 py-2 rounded-xl text-sm font-semibold bg-white/80 backdrop-blur-sm text-gray-700 border border-gray-200 shadow-sm hover:shadow-md transition-shadow duration-200">
                          <% if topic.icon.present? %>
                            <span class="mr-2 text-base"><%= topic.icon %></span>
                          <% end %>
                          <%= topic.name %>
                        </span>
                      <% end %>
                    </div>
                  </div>

                  <!-- Upvote Button -->
                  <div class="flex flex-col items-center space-y-4">
                    <button class="group/upvote relative flex flex-col items-center px-8 py-6 bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:scale-105 hover:-translate-y-1">
                      <!-- Glow on hover -->
                      <div class="absolute -inset-1 bg-gradient-to-r from-yellow-400 to-orange-400 rounded-2xl blur opacity-0 group-hover/upvote:opacity-50 transition duration-300"></div>

                      <div class="relative flex flex-col items-center">
                        <svg class="w-8 h-8 text-yellow-600 mb-2 group-hover/upvote:text-orange-600 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                        </svg>
                        <span class="text-4xl font-extrabold bg-gradient-to-br from-gray-900 to-gray-700 bg-clip-text text-transparent"><%= @product_of_day.upvotes_count %></span>
                        <span class="text-xs font-bold text-gray-500 mt-1 tracking-wider uppercase">Upvotes</span>
                      </div>
                    </button>

                    <div class="flex items-center px-4 py-2 bg-white/60 backdrop-blur-sm rounded-xl text-sm font-semibold text-gray-600">
                      <svg class="w-5 h-5 mr-2 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                      </svg>
                      <%= @product_of_day.comments_count %> comments
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Featured Products -->
    <% if @featured_products.any? %>
      <div class="mb-16">
        <div class="flex items-center justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-2" style="letter-spacing: -0.01em;">Featured Products</h2>
            <p class="text-lg text-gray-600">Hand-picked innovations making waves across Africa</p>
          </div>
          <div class="hidden md:flex items-center space-x-2">
            <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></div>
            <div class="w-2 h-2 rounded-full bg-purple-500 animate-pulse" style="animation-delay: 0.2s;"></div>
            <div class="w-2 h-2 rounded-full bg-pink-500 animate-pulse" style="animation-delay: 0.4s;"></div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <% @featured_products.each_with_index do |product, index| %>
            <%= link_to product_path(product), class: "group" do %>
              <div class="relative h-full animate-slide-up" style="animation-delay: <%= index * 0.1 %>s;">
                <!-- Gradient Border Effect -->
                <div class="absolute -inset-0.5 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500 rounded-2xl opacity-0 group-hover:opacity-100 blur transition duration-500"></div>

                <!-- Card -->
                <div class="relative h-full bg-white rounded-2xl shadow-lg overflow-hidden group-hover:shadow-2xl transition-all duration-500 transform group-hover:-translate-y-2">
                  <!-- Decorative Top Bar -->
                  <div class="h-1.5 bg-gradient-to-r from-blue-500 via-purple-500 to-pink-500"></div>

                  <div class="p-7">
                    <!-- Header -->
                    <div class="flex items-start justify-between mb-5">
                      <span class="inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-bold bg-gradient-to-r from-blue-500 to-purple-500 text-white shadow-md">
                        <svg class="w-3.5 h-3.5 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                        FEATURED
                      </span>

                      <!-- Upvote Badge -->
                      <div class="flex flex-col items-center px-4 py-2 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border border-gray-200 shadow-sm group-hover:shadow-md transition-shadow duration-300">
                        <svg class="w-5 h-5 text-gray-600 mb-0.5 group-hover:text-blue-600 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                        </svg>
                        <span class="text-lg font-extrabold text-gray-900"><%= product.upvotes_count %></span>
                      </div>
                    </div>

                    <!-- Product Info -->
                    <h3 class="text-2xl font-extrabold text-gray-900 mb-3 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-300" style="letter-spacing: -0.01em; line-height: 1.3;">
                      <%= product.name %>
                    </h3>

                    <p class="text-gray-600 text-base mb-6 leading-relaxed min-h-[3rem]">
                      <%= truncate(product.tagline, length: 90) %>
                    </p>

                    <!-- Topics -->
                    <div class="flex flex-wrap gap-2 mb-6">
                      <% product.topics.first(2).each do |topic| %>
                        <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors duration-200">
                          <% if topic.icon.present? %>
                            <span class="mr-1.5"><%= topic.icon %></span>
                          <% end %>
                          <%= topic.name %>
                        </span>
                      <% end %>
                    </div>

                    <!-- Maker -->
                    <div class="flex items-center pt-4 border-t border-gray-100">
                      <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-md">
                        <span class="text-white text-xs font-bold"><%= product.makers.first.full_name.first if product.makers.any? %></span>
                      </div>
                      <div class="ml-3">
                        <p class="text-sm font-semibold text-gray-700">
                          <%= product.makers.first.full_name if product.makers.any? %>
                        </p>
                        <p class="text-xs text-gray-500">Maker</p>
                      </div>
                    </div>
                  </div>

                  <!-- Hover Arrow -->
                  <div class="absolute bottom-6 right-6 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0 transition-all duration-300">
                    <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Filter & Sort Bar -->
    <div class="mb-10">
      <div class="bg-white rounded-2xl shadow-lg border border-gray-200/50 overflow-hidden">
        <div class="bg-gradient-to-r from-blue-50 via-purple-50 to-pink-50 px-6 py-4 border-b border-gray-200/50">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div class="flex items-center space-x-4">
              <h2 class="text-2xl font-extrabold text-gray-900" style="letter-spacing: -0.01em;">All Products</h2>
              <div class="flex items-center px-3 py-1.5 bg-white rounded-lg shadow-sm border border-gray-200">
                <span class="text-sm font-bold text-gray-900"><%= @products.total_count %></span>
                <span class="text-sm text-gray-500 ml-1">products</span>
              </div>
            </div>

            <div class="flex items-center space-x-3">
              <!-- Filter Button -->
              <button class="group inline-flex items-center px-5 py-2.5 border-2 border-gray-300 rounded-xl text-sm font-semibold text-gray-700 bg-white hover:border-blue-500 hover:bg-blue-50 hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all duration-200 shadow-sm hover:shadow-md">
                <svg class="w-5 h-5 mr-2 group-hover:text-blue-600 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                </svg>
                Filter
                <span class="ml-2 px-2 py-0.5 bg-gray-200 group-hover:bg-blue-200 rounded-md text-xs font-bold transition-colors duration-200">0</span>
              </button>

              <!-- Sort Dropdown -->
              <div class="relative">
                <button class="group inline-flex items-center px-5 py-2.5 border-2 border-gray-300 rounded-xl text-sm font-semibold text-gray-700 bg-white hover:border-purple-500 hover:bg-purple-50 hover:text-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-purple-500 transition-all duration-200 shadow-sm hover:shadow-md">
                  <svg class="w-5 h-5 mr-2 group-hover:text-purple-600 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h13M3 8h9m-9 4h6m4 0l4-4m0 0l4 4m-4-4v12"/>
                  </svg>
                  Most Recent
                  <svg class="w-4 h-4 ml-2 group-hover:text-purple-600 transition-colors duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Products Grid -->
    <% if @products.any? %>
      <div id="products-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
        <% @products.each_with_index do |product, index| %>
          <%= render 'products/product', product: product, index: index %>
        <% end %>
      </div>

      <!-- Load More Button -->
      <% if @products.next_page %>
        <div class="flex justify-center mt-12 mb-8">
          <%= link_to "Load More", 
              products_path(page: @products.next_page), 
              class: "px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200",
              data: { 
                turbo_method: :get,
                turbo_frame: "products-container"
              } %>
        </div>
      <% end %>

      <!-- Traditional Pagination (fallback) -->
      <div class="flex justify-center mt-12 mb-8">
        <%= paginate @products %>
      </div>
    <% else %>
      <!-- Empty State with Beautiful Illustration -->
      <div class="text-center py-20">
        <div class="max-w-md mx-auto">
          <!-- Custom SVG Illustration -->
          <div class="mb-8 relative">
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-64 h-64 bg-gradient-to-br from-blue-100 via-purple-100 to-pink-100 rounded-full blur-3xl opacity-50 animate-pulse-glow"></div>
            </div>
            <svg class="relative w-64 h-64 mx-auto" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
              <!-- Rocket Ship -->
              <g class="animate-float">
                <!-- Rocket Body -->
                <path d="M200 80 L220 200 L180 200 Z" fill="url(#gradient1)" stroke="#3B82F6" stroke-width="3"/>
                <ellipse cx="200" cy="200" rx="20" ry="8" fill="#60A5FA"/>

                <!-- Rocket Window -->
                <circle cx="200" cy="140" r="15" fill="#DBEAFE" stroke="#3B82F6" stroke-width="2"/>
                <circle cx="200" cy="140" r="10" fill="#93C5FD" opacity="0.5"/>

                <!-- Rocket Fins -->
                <path d="M180 180 L160 220 L180 200 Z" fill="#8B5CF6"/>
                <path d="M220 180 L240 220 L220 200 Z" fill="#8B5CF6"/>

                <!-- Rocket Flames -->
                <path d="M190 200 L185 230 L195 215 Z" fill="#F59E0B" opacity="0.8">
                  <animate attributeName="opacity" values="0.8;0.4;0.8" dur="0.5s" repeatCount="indefinite"/>
                </path>
                <path d="M200 200 L195 240 L205 215 Z" fill="#EF4444" opacity="0.8">
                  <animate attributeName="opacity" values="0.8;0.5;0.8" dur="0.6s" repeatCount="indefinite"/>
                </path>
                <path d="M210 200 L215 230 L205 215 Z" fill="#F59E0B" opacity="0.8">
                  <animate attributeName="opacity" values="0.8;0.4;0.8" dur="0.5s" repeatCount="indefinite"/>
                </path>
              </g>

              <!-- Stars -->
              <circle cx="100" cy="100" r="3" fill="#FCD34D">
                <animate attributeName="opacity" values="1;0.3;1" dur="2s" repeatCount="indefinite"/>
              </circle>
              <circle cx="300" cy="120" r="2" fill="#FCD34D">
                <animate attributeName="opacity" values="1;0.3;1" dur="1.5s" repeatCount="indefinite"/>
              </circle>
              <circle cx="320" cy="200" r="3" fill="#FCD34D">
                <animate attributeName="opacity" values="1;0.3;1" dur="2.5s" repeatCount="indefinite"/>
              </circle>
              <circle cx="80" cy="180" r="2" fill="#FCD34D">
                <animate attributeName="opacity" values="1;0.3;1" dur="1.8s" repeatCount="indefinite"/>
              </circle>

              <!-- Planets -->
              <circle cx="320" cy="280" r="25" fill="url(#gradient2)" opacity="0.6"/>
              <circle cx="80" cy="300" r="15" fill="url(#gradient3)" opacity="0.6"/>

              <!-- Gradients -->
              <defs>
                <linearGradient id="gradient1" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1" />
                </linearGradient>
                <linearGradient id="gradient2" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#EC4899;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#8B5CF6;stop-opacity:1" />
                </linearGradient>
                <linearGradient id="gradient3" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" style="stop-color:#F59E0B;stop-opacity:1" />
                  <stop offset="100%" style="stop-color:#EF4444;stop-opacity:1" />
                </linearGradient>
              </defs>
            </svg>
          </div>

          <h3 class="text-3xl font-extrabold text-gray-900 mb-4" style="letter-spacing: -0.01em;">
            No Products Yet
          </h3>
          <p class="text-xl text-gray-600 mb-8 leading-relaxed">
            Be the first to launch a product on AfriHunt!<br/>
            <span class="text-base text-gray-500">Share your innovation with the African tech community.</span>
          </p>

          <% if user_signed_in? %>
            <%= link_to new_product_path, class: "group inline-flex items-center" do %>
              <div class="relative">
                <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 rounded-xl blur opacity-50 group-hover:opacity-75 transition duration-300"></div>
                <div class="relative inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300">
                  <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                  </svg>
                  Launch Your Product
                  <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                  </svg>
                </div>
              </div>
            <% end %>
          <% else %>
            <%= link_to new_user_registration_path, class: "group inline-flex items-center" do %>
              <div class="relative">
                <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 via-purple-600 to-pink-600 rounded-xl blur opacity-50 group-hover:opacity-75 transition duration-300"></div>
                <div class="relative inline-flex items-center px-8 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-300">
                  <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                  </svg>
                  Sign Up to Launch
                  <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                  </svg>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
