<%= turbo_stream.append "modal-container" do %>
  <div id="product-modal" class="fixed inset-0 z-50 overflow-y-auto" data-controller="modal">
    <!-- Background overlay -->
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
      <div class="fixed inset-0 transition-opacity" data-action="click->modal#close">
        <div class="absolute inset-0 bg-gray-900 opacity-75"></div>
      </div>
      <!-- Modal panel -->
      <div class="inline-block align-bottom bg-white rounded-2xl text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-4xl sm:w-full">
        <div class="bg-gradient-to-br from-blue-600 via-purple-600 to-pink-600 text-white p-6">
          <div class="flex items-start justify-between">
            <div class="flex-1">
              <h3 class="text-2xl font-extrabold mb-2"><%= @product.name %></h3>
              <p class="text-blue-100"><%= @product.tagline %></p>
            </div>
            <button data-action="click->modal#close" class="ml-4 text-white hover:text-gray-200 transition-colors duration-200">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="p-6">
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Product Info -->
            <div class="lg:col-span-2 space-y-6">
              <!-- Description -->
              <div>
                <h4 class="text-lg font-semibold text-gray-900 mb-3">About this product</h4>
                <p class="text-gray-700 leading-relaxed"><%= @product.description %></p>
              </div>
              <!-- Topics -->
              <% if @product.topics.any? %>
                <div>
                  <h4 class="text-lg font-semibold text-gray-900 mb-3">Topics</h4>
                  <div class="flex flex-wrap gap-2">
                    <% @product.topics.each do |topic| %>
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-blue-100 text-blue-800">
                        <% if topic.icon.present? %>
                          <span class="mr-2"><%= topic.icon %></span>
                        <% end %>
                        <%= topic.name %>
                      </span>
                    <% end %>
                  </div>
                </div>
              <% end %>
              <!-- Makers -->
              <div>
                <h4 class="text-lg font-semibold text-gray-900 mb-3">Created by</h4>
                <div class="flex items-center space-x-3">
                  <% @product.makers.each do |maker| %>
                    <%= link_to user_path(maker), class: "flex items-center space-x-2 group" do %>
                      <div class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center">
                        <span class="text-white text-sm font-bold"><%= maker.full_name.first %></span>
                      </div>
                      <span class="text-gray-700 font-medium group-hover:text-blue-600 transition-colors duration-200">
                        <%= maker.full_name %>
                      </span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
            <!-- Sidebar -->
            <div class="space-y-6">
              <!-- Upvote Button -->
              <%= turbo_frame_tag "upvote_#{@product.id}" do %>
                <%= link_to toggle_upvote_product_path(@product), 
                    class: "w-full flex flex-col items-center px-6 py-4 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-200",
                    data: { turbo_method: :post } do %>
                  <svg class="w-6 h-6 mb-2 <%= 'text-yellow-300' if current_user&.upvoted?(@product) %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                  </svg>
                  <span class="text-xl font-bold"><%= @product.upvotes_count %></span>
                  <span class="text-sm">Upvotes</span>
                <% end %>
              <% end %>
              <!-- Stats -->
              <div class="bg-gray-50 rounded-xl p-4">
                <h4 class="text-lg font-semibold text-gray-900 mb-3">Stats</h4>
                <div class="space-y-2">
                  <div class="flex justify-between">
                    <span class="text-gray-600">Comments</span>
                    <span class="font-semibold"><%= @product.comments_count %></span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-gray-600">Launch Date</span>
                    <span class="font-semibold text-sm"><%= @product.launch_date&.strftime("%b %d, %Y") || "Not launched" %></span>
                  </div>
                  <% if @product.pricing_type.present? %>
                    <div class="flex justify-between">
                      <span class="text-gray-600">Pricing</span>
                      <span class="font-semibold capitalize"><%= @product.pricing_type %></span>
                    </div>
                  <% end %>
                </div>
              </div>
              <!-- Action Buttons -->
              <div class="space-y-3">
                <%= link_to "Visit Website", @product.website_url, 
                    target: "_blank", 
                    rel: "noopener noreferrer",
                    class: "w-full inline-flex items-center justify-center px-6 py-3 bg-white border-2 border-blue-600 text-blue-600 rounded-xl font-semibold hover:bg-blue-50 transition-colors duration-200" %>
                <%= link_to "View Full Details", product_path(@product), 
                    class: "w-full inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-200" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
