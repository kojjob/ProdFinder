<% content_for :title, "#{@product.name} - AfriHunt" %>
<div class="min-h-screen bg-gray-50">
  <!-- Product Header -->
  <div class="bg-white border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8">
        <!-- Product Info -->
        <div class="flex-1">
          <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 mb-3">
            <%= @product.name %>
          </h1>
          <p class="text-xl text-gray-600 mb-6 leading-relaxed">
            <%= @product.tagline %>
          </p>
          <!-- Makers -->
          <div class="flex items-center mb-6">
            <span class="text-sm text-gray-500 mr-3">Created by</span>
            <div class="flex items-center -space-x-2">
              <% @product.makers.each do |maker| %>
                <%= link_to user_path(maker), class: "group relative", title: maker.full_name do %>
                  <div class="w-8 h-8 rounded-full bg-gray-300 border-2 border-white shadow-sm flex items-center justify-center transform hover:scale-110 hover:z-10 transition-all duration-200">
                    <span class="text-white text-sm font-medium"><%= maker.full_name.first %></span>
                  </div>
                <% end %>
              <% end %>
            </div>
            <div class="ml-3 text-sm text-gray-600">
              <% @product.makers.each_with_index do |maker, index| %>
                <% if index > 0 %><span class="text-gray-400">,</span><% end %>
                <%= link_to maker.full_name, user_path(maker), class: "text-gray-900 hover:text-blue-600 transition-colors" %>
              <% end %>
            </div>
          </div>
          <!-- Topics -->
          <% if @product.topics.any? %>
            <div class="flex flex-wrap gap-2 mb-6">
              <% @product.topics.each do |topic| %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-gray-100 text-gray-700">
                  <% if topic.icon.present? %>
                    <span class="mr-1.5"><%= topic.icon %></span>
                  <% end %>
                  <%= topic.name %>
                </span>
              <% end %>
            </div>
          <% end %>
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <%= link_to @product.website_url,
                target: "_blank",
                rel: "noopener noreferrer",
                class: "inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white rounded-lg font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" do %>
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
              </svg>
              Visit Website
            <% end %>
            <% if @product.pricing_type.present? %>
              <div class="px-4 py-2 bg-gray-100 rounded-lg text-center">
                <span class="text-gray-900 font-medium capitalize"><%= @product.pricing_type %></span>
              </div>
            <% end %>
          </div>
        </div>
        <!-- Upvote Section -->
        <div class="lg:w-48">
          <%= turbo_frame_tag "upvote_#{@product.id}" do %>
            <% if current_user&.upvoted?(@product) %>
              <%= button_to toggle_upvote_product_path(@product),
                  class: "w-full flex flex-col items-center px-6 py-4 bg-amber-50 border border-amber-200 rounded-lg hover:bg-amber-100 transition-colors",
                  form: { data: { turbo_frame: "upvote_#{@product.id}" } } do %>
                <svg class="w-6 h-6 mb-2 text-amber-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M3.293 9.707a1 1 0 010-1.414l6-6a1 1 0 011.414 0l6 6a1 1 0 01-1.414 1.414L11 5.414V17a1 1 0 11-2 0V5.414L4.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                </svg>
                <span class="text-2xl font-bold text-amber-600"><%= @product.upvotes_count %></span>
                <span class="text-sm font-medium text-gray-600">Upvotes</span>
              <% end %>
            <% else %>
              <%= button_to toggle_upvote_product_path(@product),
                  class: "w-full flex flex-col items-center px-6 py-4 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 hover:border-gray-300 transition-colors",
                  form: { data: { turbo_frame: "upvote_#{@product.id}" } } do %>
                <svg class="w-6 h-6 mb-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 20 20" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                </svg>
                <span class="text-2xl font-bold text-gray-900"><%= @product.upvotes_count %></span>
                <span class="text-sm font-medium text-gray-600">Upvotes</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <!-- Product Details -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-lg border border-gray-200">
      <!-- Description -->
      <div class="p-8 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">About</h2>
        <p class="text-gray-700 leading-relaxed">
          <%= @product.description %>
        </p>
      </div>
      <!-- Stats -->
      <div class="p-8 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900 mb-6">Stats</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900"><%= @product.upvotes_count %></div>
            <div class="text-sm text-gray-500">Upvotes</div>
          </div>
          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900"><%= @product.comments_count %></div>
            <div class="text-sm text-gray-500">Comments</div>
          </div>
          <div class="text-center">
            <div class="text-lg font-bold text-gray-900"><%= @product.launch_date&.strftime("%b %d, %Y") || "Coming Soon" %></div>
            <div class="text-sm text-gray-500">Launch Date</div>
          </div>
        </div>
      </div>
      <!-- Maker Comment -->
      <% if @product.maker_comment.present? %>
        <div class="p-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Maker's Note</h2>
          <p class="text-gray-700 leading-relaxed">
            <%= @product.maker_comment %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
  <!-- Comments Section -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="bg-white rounded-lg border border-gray-200">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">
          Discussion (<%= @product.comments_count %>)
        </h2>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-6">
        <!-- Comments List -->
        <div class="lg:col-span-2">
          <div id="comments" class="space-y-4">
            <%= turbo_frame_tag "comments_list" do %>
              <% if @comments.any? %>
                <% @comments.each do |comment| %>
                  <%= render 'comments/comment', comment: comment %>
                <% end %>
              <% else %>
                <div class="text-center py-8">
                  <div class="w-12 h-12 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-3">
                    <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                  </div>
                  <h3 class="text-lg font-medium text-gray-900 mb-2">No comments yet</h3>
                  <p class="text-gray-500">Be the first to share your thoughts about this product!</p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
        <!-- Comment Form -->
        <div class="lg:col-span-1">
          <% if user_signed_in? %>
            <div class="bg-gray-50 rounded-lg p-4">
              <h3 class="text-sm font-medium text-gray-900 mb-3">Add a comment</h3>
              <%= form_with(model: [@product, @comment],
                  data: {
                    turbo: true,
                    controller: "form-validation",
                    action: "input->form-validation#input blur->form-validation#blur"
                  },
                  class: "space-y-3") do |f| %>
                <%= turbo_frame_tag "comment_form" do %>
                  <div>
                    <%= f.text_area :content,
                        rows: 4,
                        placeholder: "Share your thoughts...",
                        class: "w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:ring-blue-500 focus:border-blue-500 resize-none",
                        required: true,
                        maxlength: 1000,
                        data: {
                          form_validation_target: "textarea"
                        } %>
                    <div class="mt-2 flex items-center justify-between">
                      <span class="text-xs text-gray-500" data-form-validation_target="charCount">
                        0 / 1000
                      </span>
                    </div>
                  </div>
                  <div class="space-y-2">
                    <div class="text-xs text-gray-500">
                      Commenting as <span class="font-medium text-gray-900"><%= current_user.full_name %></span>
                    </div>
                    <%= f.submit "Post Comment",
                        data: { form_validation_target: "submit" },
                        class: "w-full px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="bg-gray-50 rounded-lg p-6 text-center">
              <div class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <h3 class="text-sm font-medium text-gray-900 mb-2">Sign in to comment</h3>
              <p class="text-xs text-gray-500 mb-4">Join the discussion about this product</p>
              <%= link_to "Sign In", new_user_session_path, class: "inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-md text-sm font-medium hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- Comments List -->
<div id="comments" class="p-8 space-y-6 bg-gray-50">
  <%= turbo_frame_tag "comments_list" do %>
    <% if @comments.any? %>
      <% @comments.each do |comment| %>
        <%= render 'comments/comment', comment: comment %>
      <% end %>
    <% else %>
      <!-- Empty State -->
      <div class="text-center py-16">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-blue-50 rounded-full mb-6 border-2 border-blue-100">
          <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">No comments yet</h3>
        <p class="text-lg text-gray-600 max-w-md mx-auto">Be the first to share your thoughts about this product!</p>
      </div>
    <% end %>
  <% end %>
</div>
</div>
</div>
<!-- Comment Form -->
<div class="lg:col-span-1">
  <% if user_signed_in? %>
    <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 overflow-hidden sticky top-6">
      <!-- Header - Clean Design -->
      <div class="bg-white px-6 py-5 border-b-2 border-gray-200">
        <h3 class="text-xl font-bold text-gray-900 flex items-center">
          <svg class="w-6 h-6 mr-2 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
          </svg>
          Join Discussion
        </h3>
      </div>
      <!-- Form -->
      <div class="p-6 bg-gray-50">
        <%= form_with(model: [@product, @comment],
                  data: {
                    turbo: true,
                    controller: "form-validation",
                    action: "input->form-validation#input blur->form-validation#blur"
                  },
                  class: "space-y-5") do |f| %>
          <%= turbo_frame_tag "comment_form" do %>
            <div>
              <%= f.text_area :content,
                        rows: 5,
                        placeholder: "Share your thoughts about this product...",
                        class: "w-full px-5 py-4 border-2 border-gray-300 rounded-2xl focus:ring-4 focus:ring-blue-100 focus:border-blue-500 transition-all duration-200 resize-none text-base bg-white",
                        required: true,
                        maxlength: 1000,
                        data: {
                          form_validation_target: "textarea"
                        } %>
              <div class="mt-3 flex items-center justify-between">
                <span class="text-sm font-semibold text-gray-500" data-form-validation-target="charCount">
                  0 / 1000
                </span>
              </div>
            </div>
            <div class="flex flex-col space-y-3">
              <div class="text-sm text-gray-600 font-medium">
                Commenting as <span class="text-blue-600 font-bold"><%= current_user.full_name %></span>
              </div>
              <%= f.submit "Post Comment",
                        data: { form_validation_target: "submit" },
                        class: "w-full px-8 py-4 bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 text-white rounded-2xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-200" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% else %>
    <!-- Sign In Prompt -->
    <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 overflow-hidden sticky top-6">
      <div class="p-10 text-center">
        <div class="inline-flex items-center justify-center w-20 h-20 bg-blue-50 rounded-full mb-6 border-2 border-blue-100">
          <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-3">Sign in to Comment</h3>
        <p class="text-base text-gray-600 mb-6 leading-relaxed">Join the discussion and share your thoughts about this product</p>
        <%= link_to new_user_session_path, class: "inline-flex items-center px-8 py-4 bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 text-white rounded-2xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-200" do %>
          <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
          </svg>
          Sign In
        <% end %>
      </div>
    </div>
  <% end %>
</div>
</div>
</div>
</div>
