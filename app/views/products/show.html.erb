<% content_for :title, "#{@product.name} - AfriHunt" %>
<div class="min-h-screen bg-white">
  <!-- Product Header - Clean White Background -->
  <div class="bg-white border-b-2 border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Product Info -->
        <div class="lg:col-span-2">
          <div class="flex items-start justify-between mb-10">
            <div class="flex-1">
              <h1 class="text-5xl md:text-6xl font-bold mb-6 tracking-tight leading-tight text-gray-900">
                <%= @product.name %>
              </h1>
              <p class="text-2xl text-gray-700 mb-8 font-medium leading-relaxed">
                <%= @product.tagline %>
              </p>
            </div>
            <!-- Upvote Button - Clean Design -->
            <%= turbo_frame_tag "upvote_#{@product.id}" do %>
              <%= link_to toggle_upvote_product_path(@product),
                  class: "group/upvote flex flex-col items-center px-8 py-6 bg-white rounded-2xl border-2 <%= current_user&.upvoted?(@product) ? 'border-teal-500 bg-teal-50' : 'border-gray-200' %> hover:border-teal-500 hover:bg-teal-50 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-105",
                  data: {
                    turbo_method: :post,
                    controller: "upvote-animation",
                    action: "click->upvote-animation#animate"
                  } do %>
                <svg class="w-10 h-10 mb-2 transition-colors duration-200 <%= current_user&.upvoted?(@product) ? 'text-teal-600' : 'text-gray-400' %> group-hover/upvote:text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                </svg>
                <span class="text-4xl font-bold <%= current_user&.upvoted?(@product) ? 'text-teal-600' : 'text-gray-900' %> group-hover/upvote:text-teal-600"><%= @product.upvotes_count %></span>
                <span class="text-sm font-bold text-gray-600 mt-1">Upvotes</span>
              <% end %>
            <% end %>
          </div>
          <!-- Product Details -->
          <div class="space-y-8">
            <!-- Description Card -->
            <div class="bg-gray-50 rounded-2xl p-8 border-2 border-gray-200">
              <h3 class="text-xl font-bold mb-4 text-gray-900 flex items-center">
                <svg class="w-6 h-6 mr-2 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                About this product
              </h3>
              <p class="text-gray-700 leading-relaxed text-lg">
                <%= @product.description %>
              </p>
            </div>

            <!-- Topics -->
            <% if @product.topics.any? %>
              <div class="flex flex-wrap gap-3">
                <% @product.topics.each do |topic| %>
                  <span class="inline-flex items-center px-5 py-2.5 rounded-full text-sm font-bold bg-white text-gray-700 border-2 border-gray-200 hover:border-teal-500 hover:bg-teal-50 hover:text-teal-700 transition-all duration-200">
                    <% if topic.icon.present? %>
                      <span class="mr-2 text-base"><%= topic.icon %></span>
                    <% end %>
                    <%= topic.name %>
                  </span>
                <% end %>
              </div>
            <% end %>

            <!-- Makers -->
            <div class="bg-gray-50 rounded-2xl p-6 border-2 border-gray-200">
              <div class="flex items-center space-x-4">
                <span class="text-base font-bold text-gray-600">Created by</span>
                <div class="flex items-center -space-x-3">
                  <% @product.makers.each do |maker| %>
                    <%= link_to user_path(maker), class: "group relative" do %>
                      <div class="w-14 h-14 rounded-full bg-gradient-to-br from-teal-500 to-blue-600 border-4 border-white shadow-lg flex items-center justify-center transform hover:scale-110 hover:z-10 transition-all duration-200" title="<%= maker.full_name %>">
                        <span class="text-white text-lg font-bold"><%= maker.full_name.first %></span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
                <div class="flex items-center flex-wrap gap-2">
                  <% @product.makers.each_with_index do |maker, index| %>
                    <% if index > 0 %><span class="text-gray-400">,</span><% end %>
                    <%= link_to maker.full_name, user_path(maker), class: "text-gray-900 font-bold hover:text-teal-600 transition-colors duration-200" %>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
              <%= link_to @product.website_url,
                  target: "_blank",
                  rel: "noopener noreferrer",
                  class: "inline-flex items-center justify-center px-10 py-5 bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 text-white rounded-2xl font-bold text-xl shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-300" do %>
                <svg class="w-7 h-7 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                Visit Website
              <% end %>
              <% if @product.pricing_type.present? %>
                <div class="px-8 py-4 bg-gray-100 rounded-2xl border-2 border-gray-200 text-center">
                  <span class="text-gray-900 font-bold text-lg capitalize"><%= @product.pricing_type %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Stats Card - Clean Design -->
          <div class="bg-white rounded-2xl p-8 border-2 border-gray-200 shadow-lg">
            <h3 class="text-xl font-bold mb-6 text-gray-900 flex items-center">
              <svg class="w-6 h-6 mr-2 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
              </svg>
              Product Stats
            </h3>
            <div class="space-y-4">
              <!-- Upvotes with Red accent -->
              <div class="flex items-center justify-between p-4 bg-red-50 rounded-xl border-2 border-red-100">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 bg-gradient-to-br from-red-500 to-red-600 rounded-lg flex items-center justify-center shadow-md">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                    </svg>
                  </div>
                  <span class="text-gray-700 font-semibold">Upvotes</span>
                </div>
                <span class="text-3xl font-bold text-red-600"><%= @product.upvotes_count %></span>
              </div>

              <!-- Comments with Blue accent -->
              <div class="flex items-center justify-between p-4 bg-blue-50 rounded-xl border-2 border-blue-100">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center shadow-md">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                  </div>
                  <span class="text-gray-700 font-semibold">Comments</span>
                </div>
                <span class="text-3xl font-bold text-blue-600"><%= @product.comments_count %></span>
              </div>

              <!-- Launch Date with Teal accent -->
              <div class="flex items-center justify-between p-4 bg-teal-50 rounded-xl border-2 border-teal-100">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 bg-gradient-to-br from-teal-500 to-teal-600 rounded-lg flex items-center justify-center shadow-md">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <span class="text-gray-700 font-semibold">Launched</span>
                </div>
                <span class="text-base font-bold text-teal-600"><%= @product.launch_date&.strftime("%b %d, %Y") || "Coming Soon" %></span>
              </div>
            </div>
          </div>

          <!-- Maker Comment -->
          <% if @product.maker_comment.present? %>
            <div class="bg-white rounded-2xl p-8 border-2 border-gray-200 shadow-lg">
              <h3 class="text-xl font-bold mb-4 text-gray-900 flex items-center">
                <svg class="w-6 h-6 mr-2 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
                </svg>
                Maker's Note
              </h3>
              <p class="text-gray-700 text-base leading-relaxed">
                <%= @product.maker_comment %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <!-- Comments Section -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 bg-gray-50">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Comments List -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 overflow-hidden">
          <!-- Header - Clean Design -->
          <div class="bg-white px-8 py-6 border-b-2 border-gray-200">
            <h2 class="text-3xl font-bold text-gray-900 flex items-center">
              <svg class="w-8 h-8 mr-3 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              Discussion (<%= @product.comments_count %>)
            </h2>
          </div>

          <!-- Comments List -->
          <div id="comments" class="p-8 space-y-6 bg-gray-50">
            <%= turbo_frame_tag "comments_list" do %>
              <% if @comments.any? %>
                <% @comments.each do |comment| %>
                  <%= render 'comments/comment', comment: comment %>
                <% end %>
              <% else %>
                <!-- Empty State -->
                <div class="text-center py-16">
                  <div class="inline-flex items-center justify-center w-20 h-20 bg-blue-50 rounded-full mb-6 border-2 border-blue-100">
                    <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                  </div>
                  <h3 class="text-2xl font-bold text-gray-900 mb-3">No comments yet</h3>
                  <p class="text-lg text-gray-600 max-w-md mx-auto">Be the first to share your thoughts about this product!</p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      <!-- Comment Form -->
      <div class="lg:col-span-1">
        <% if user_signed_in? %>
          <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 overflow-hidden sticky top-6">
            <!-- Header - Clean Design -->
            <div class="bg-white px-6 py-5 border-b-2 border-gray-200">
              <h3 class="text-xl font-bold text-gray-900 flex items-center">
                <svg class="w-6 h-6 mr-2 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Join Discussion
              </h3>
            </div>

            <!-- Form -->
            <div class="p-6 bg-gray-50" data-controller="product" data-product-product-id-value="<%= @product.id %>">
              <%= form_with(model: [@product, @comment],
                  data: {
                    turbo: true,
                    controller: "form-validation",
                    action: "submit->product#submitComment input->form-validation#input blur->form-validation#blur"
                  },
                  class: "space-y-5") do |f| %>
                <%= turbo_frame_tag "comment_form" do %>
                  <div>
                    <%= f.text_area :content,
                        rows: 5,
                        placeholder: "Share your thoughts about this product...",
                        class: "w-full px-5 py-4 border-2 border-gray-300 rounded-2xl focus:ring-4 focus:ring-blue-100 focus:border-blue-500 transition-all duration-200 resize-none text-base bg-white",
                        required: true,
                        maxlength: 1000,
                        data: {
                          form_validation_target: "textarea",
                          action: "input->product#autoSave"
                        } %>
                    <div class="mt-3 flex items-center justify-between">
                      <span class="text-sm font-semibold text-gray-500" data-form-validation-target="charCount">
                        0 / 1000
                      </span>
                    </div>
                  </div>

                  <div class="flex flex-col space-y-3">
                    <div class="text-sm text-gray-600 font-medium">
                      Commenting as <span class="text-blue-600 font-bold"><%= current_user.full_name %></span>
                    </div>
                    <%= f.submit "Post Comment",
                        data: { form_validation_target: "submit" },
                        class: "w-full px-8 py-4 bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 text-white rounded-2xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-200" %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% else %>
          <!-- Sign In Prompt -->
          <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-200 overflow-hidden sticky top-6">
            <div class="p-10 text-center">
              <div class="inline-flex items-center justify-center w-20 h-20 bg-blue-50 rounded-full mb-6 border-2 border-blue-100">
                <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-gray-900 mb-3">Sign in to Comment</h3>
              <p class="text-base text-gray-600 mb-6 leading-relaxed">Join the discussion and share your thoughts about this product</p>
              <%= link_to new_user_session_path, class: "inline-flex items-center px-8 py-4 bg-gradient-to-r from-red-600 via-blue-600 to-teal-500 text-white rounded-2xl font-bold text-lg shadow-lg hover:shadow-xl transform hover:scale-[1.02] active:scale-[0.98] transition-all duration-200" do %>
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                </svg>
                Sign In
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
