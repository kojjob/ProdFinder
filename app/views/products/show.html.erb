<% content_for :title, "#{@product.name} - AfriHunt" %>
<div class="min-h-screen bg-gray-50">
  <!-- Product Header -->
  <div class="bg-gradient-to-br from-blue-600 via-purple-600 to-pink-600 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Product Info -->
        <div class="lg:col-span-2">
          <div class="flex items-start justify-between mb-6">
            <div>
              <h1 class="text-4xl md:text-5xl font-extrabold mb-4" style="letter-spacing: -0.02em;">
                <%= @product.name %>
              </h1>
              <p class="text-2xl text-blue-100 mb-6 font-medium">
                <%= @product.tagline %>
              </p>
            </div>
            <!-- Upvote Button -->
            <%= turbo_frame_tag "upvote_#{@product.id}" do %>
              <%= link_to toggle_upvote_product_path(@product), 
                  class: "group/upvote flex flex-col items-center px-8 py-6 bg-white/10 backdrop-blur-sm rounded-2xl border-2 border-white/20 hover:bg-white/20 transition-all duration-300 shadow-lg hover:shadow-xl transform hover:scale-105",
                  data: { turbo_method: :post } do %>
                <svg class="w-8 h-8 text-yellow-300 mb-2 group-hover/upvote:text-yellow-200 transition-colors duration-200 <%= 'text-yellow-200' if current_user&.upvoted?(@product) %>" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                </svg>
                <span class="text-3xl font-extrabold text-white"><%= @product.upvotes_count %></span>
                <span class="text-sm font-bold text-blue-200 mt-1">Upvotes</span>
              <% end %>
            <% end %>
          </div>
          <!-- Product Details -->
          <div class="space-y-6">
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
              <h3 class="text-lg font-semibold mb-3 text-yellow-300">About this product</h3>
              <p class="text-blue-100 leading-relaxed">
                <%= @product.description %>
              </p>
            </div>
            <!-- Topics -->
            <% if @product.topics.any? %>
              <div class="flex flex-wrap gap-3">
                <% @product.topics.each do |topic| %>
                  <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-semibold bg-white/20 backdrop-blur-sm text-white border border-white/30">
                    <% if topic.icon.present? %>
                      <span class="mr-2"><%= topic.icon %></span>
                    <% end %>
                    <%= topic.name %>
                  </span>
                <% end %>
              </div>
            <% end %>
            <!-- Makers -->
            <div class="flex items-center space-x-4">
              <span class="text-sm font-semibold text-blue-200">Created by</span>
              <div class="flex items-center -space-x-3">
                <% @product.makers.each do |maker| %>
                  <%= link_to user_path(maker), class: "group" do %>
                    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-yellow-400 to-orange-500 border-3 border-white shadow-lg flex items-center justify-center transform hover:scale-110 transition-transform duration-200" title="<%= maker.full_name %>">
                      <span class="text-white text-sm font-bold"><%= maker.full_name.first %></span>
                    </div>
                  <% end %>
                <% end %>
              </div>
              <div class="flex items-center space-x-2">
                <% @product.makers.each_with_index do |maker, index| %>
                  <% if index > 0 %>, <% end %>
                  <%= link_to maker.full_name, user_path(maker), class: "text-white font-semibold hover:text-yellow-300 transition-colors duration-200" %>
                <% end %>
              </div>
            </div>
            <!-- Action Buttons -->
            <div class="flex items-center space-x-4">
              <%= link_to @product.website_url, 
                  target: "_blank", 
                  rel: "noopener noreferrer",
                  class: "inline-flex items-center px-8 py-4 bg-white text-blue-600 rounded-xl font-bold text-lg shadow-xl hover:shadow-2xl transform hover:-translate-y-1 transition-all duration-300" do %>
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                </svg>
                Visit Website
              <% end %>
              <% if @product.pricing_type.present? %>
                <div class="px-6 py-3 bg-white/20 backdrop-blur-sm rounded-xl border border-white/30">
                  <span class="text-white font-semibold capitalize"><%= @product.pricing_type %></span>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- Stats -->
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
            <h3 class="text-lg font-semibold mb-4 text-yellow-300">Product Stats</h3>
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-blue-200">Upvotes</span>
                <span class="text-2xl font-bold text-white"><%= @product.upvotes_count %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-blue-200">Comments</span>
                <span class="text-2xl font-bold text-white"><%= @product.comments_count %></span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-blue-200">Launch Date</span>
                <span class="text-sm font-semibold text-white"><%= @product.launch_date&.strftime("%b %d, %Y") || "Not launched" %></span>
              </div>
            </div>
          </div>
          <!-- Maker Comment -->
          <% if @product.maker_comment.present? %>
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 border border-white/20">
              <h3 class="text-lg font-semibold mb-3 text-yellow-300">Maker's Note</h3>
              <p class="text-blue-100 text-sm leading-relaxed">
                <%= @product.maker_comment %>
              </p>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <!-- Comments Section -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Comments List -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden">
          <div class="bg-gradient-to-r from-blue-50 to-purple-50 px-6 py-4 border-b border-gray-200">
            <h2 class="text-2xl font-extrabold text-gray-900">
              Discussion (<%= @product.comments_count %>)
            </h2>
          </div>
          <div id="comments" class="p-6 space-y-6">
            <%= turbo_frame_tag "comments_list" do %>
              <% if @comments.any? %>
                <% @comments.each do |comment| %>
                  <%= render 'comments/comment', comment: comment %>
                <% end %>
              <% else %>
                <div class="text-center py-12">
                  <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                  <h3 class="text-lg font-semibold text-gray-900 mb-2">No comments yet</h3>
                  <p class="text-gray-600">Be the first to share your thoughts about this product!</p>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
      <!-- Comment Form -->
      <div class="lg:col-span-1">
        <% if user_signed_in? %>
          <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden sticky top-6">
            <div class="bg-gradient-to-r from-blue-50 to-purple-50 px-6 py-4 border-b border-gray-200">
              <h3 class="text-lg font-semibold text-gray-900">Join the Discussion</h3>
            </div>
            <div class="p-6" data-controller="product" data-product-product-id-value="<%= @product.id %>">
              <%= form_with(model: [@product, @comment], 
                  data: { 
                    turbo: true,
                    controller: "form-validation",
                    action: "submit->product#submitComment input->form-validation#input blur->form-validation#blur"
                  }, 
                  class: "space-y-4") do |f| %>
                <%= turbo_frame_tag "comment_form" do %>
                  <div>
                    <%= f.text_area :content, 
                        rows: 4,
                        placeholder: "Share your thoughts about this product...",
                        class: "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all duration-200 resize-none",
                        required: true,
                        maxlength: 1000,
                        data: { 
                          form_validation_target: "textarea",
                          action: "input->product#autoSave"
                        } %>
                    <div class="mt-2 flex items-center justify-between">
                      <span class="text-sm text-gray-500" data-form-validation-target="charCount">
                        0
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center justify-between">
                    <div class="text-sm text-gray-600">
                      Commenting as <%= current_user.full_name %>
                    </div>
                    <%= f.submit "Post Comment", 
                        data: { form_validation_target: "submit" },
                        class: "px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" %>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        <% else %>
          <div class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden sticky top-6">
            <div class="p-6 text-center">
              <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <h3 class="text-lg font-semibold text-gray-900 mb-2">Sign in to Comment</h3>
              <p class="text-gray-600 mb-4">Join the discussion about this product</p>
              <%= link_to new_user_session_path, class: "inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg font-semibold shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200" do %>
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                </svg>
                Sign In
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<!-- Stimulus Controller for Character Count -->
<%= javascript_tag do %>
  document.addEventListener('DOMContentLoaded', function() {
  const textarea = document.querySelector('textarea[name="comment[content]"]');
  const charCount = document.getElementById('char-count');
  if (textarea && charCount) {
  textarea.addEventListener('input', function() {
  charCount.textContent = this.value.length;
  });
  }
  });
<% end %>
