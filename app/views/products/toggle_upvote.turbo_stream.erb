<%= turbo_stream.replace "upvote_#{@product.id}" do %>
  <%= button_to toggle_upvote_product_path(@product),
      class: "group/upvote flex flex-col items-center px-4 py-3 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border border-gray-200 hover:from-red-50 hover:to-orange-50 hover:border-red-300 transition-all duration-300 shadow-sm hover:shadow-md transform hover:scale-105",
      data: {
        controller: "upvote-animation",
        action: "click->upvote-animation#animate",
        upvote_animation_target: "button"
      },
      form: { data: { turbo_frame: "upvote_#{@product.id}" } } do %>
    <svg class="w-5 h-5 text-gray-600 group-hover/upvote:text-red-600 mb-1 transition-colors duration-200 <%= 'text-red-600' if @upvoted %>"
         fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"
         data-upvote-animation-target="icon">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
    </svg>
    <span class="text-base font-extrabold text-gray-900" data-upvote-animation-target="count"><%= @product.upvotes_count %></span>
  <% end %>
<% end %>
<% if @upvoted %>
  <%= turbo_stream.append "toast-container" do %>
    <script>
      showToast('Product upvoted! 🎉', 'success', { title: 'Success', duration: 2000 });
    </script>
  <% end %>
<% end %>
