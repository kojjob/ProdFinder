<% content_for :title, "Settings - AfriHunt" %>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }
  
  @keyframes pulse-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }
  
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .animate-float { animation: float 6s ease-in-out infinite; }
  .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
  .animate-slide-up { animation: slide-up 0.6s ease-out forwards; }
  
  .glass-effect {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .tab-content { display: none; }
  .tab-content.active { display: block; }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-purple-50/30">
  <!-- Header -->
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-600 via-purple-600 to-pink-500">
    <!-- Animated Background Patterns -->
    <div class="absolute inset-0 opacity-10">
      <svg class="absolute top-10 right-20 w-32 h-32 text-white animate-float" style="animation-delay: 0s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90,-16.3,88.5,-0.9C87,14.6,81.4,29.2,73.1,42.8C64.8,56.4,53.8,69,40.3,76.8C26.8,84.6,11.1,87.6,-4.8,85.9C-20.7,84.2,-41.4,77.8,-56.6,67.1C-71.8,56.4,-81.5,41.4,-85.6,25.1C-89.7,8.8,-88.2,-8.8,-82.3,-24.7C-76.4,-40.6,-66.1,-54.8,-53.1,-62.3C-40.1,-69.8,-24.4,-70.6,-9.3,-73.9C5.8,-77.2,30.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
      </svg>
      <svg class="absolute bottom-10 left-20 w-40 h-40 text-white animate-float" style="animation-delay: 1.5s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M39.5,-65.5C51.4,-58.3,61.3,-47.6,68.4,-35.2C75.5,-22.8,79.8,-8.7,79.3,5.3C78.8,19.3,73.5,33.2,65.1,45.3C56.7,57.4,45.2,67.7,32.1,73.4C19,79.1,4.3,80.2,-10.3,77.8C-24.9,75.4,-39.4,69.5,-51.8,60.3C-64.2,51.1,-74.5,38.6,-78.9,24.5C-83.3,10.4,-81.8,-5.3,-76.2,-19.4C-70.6,-33.5,-60.9,-46,-48.8,-53.6C-36.7,-61.2,-22.2,-63.9,-8.3,-66.8C5.6,-69.7,27.6,-72.7,39.5,-65.5Z" transform="translate(100 100)" />
      </svg>
    </div>
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <div class="inline-flex items-center px-4 py-2 rounded-full glass-effect mb-6 animate-slide-up">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span class="text-sm font-semibold tracking-wide">Account Management</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4 animate-slide-up" style="animation-delay: 0.1s; letter-spacing: -0.02em;">
          Settings & Preferences
        </h1>
        <p class="text-xl text-blue-100 max-w-2xl mx-auto animate-slide-up" style="animation-delay: 0.2s; font-weight: 300;">
          Manage your account, privacy, and notification preferences
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Flash Messages -->
    <% if flash[:notice] %>
      <div class="mb-8 bg-green-50 border-l-4 border-green-500 p-6 rounded-xl animate-slide-up">
        <div class="flex">
          <svg class="h-6 w-6 text-green-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <p class="ml-3 text-base font-semibold text-green-800"><%= flash[:notice] %></p>
        </div>
      </div>
    <% end %>

    <% if flash[:error] %>
      <div class="mb-8 bg-red-50 border-l-4 border-red-500 p-6 rounded-xl animate-slide-up">
        <div class="flex">
          <svg class="h-6 w-6 text-red-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
          </svg>
          <p class="ml-3 text-base font-semibold text-red-800"><%= flash[:error] %></p>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Sidebar Navigation -->
      <div class="lg:col-span-1">
        <nav class="bg-white rounded-2xl shadow-md border border-gray-200/50 p-4 sticky top-8 animate-slide-up" style="animation-delay: 0.3s;">
          <ul class="space-y-2">
            <li>
              <button onclick="switchTab('account')" data-tab="account" class="tab-button w-full text-left px-4 py-3 rounded-xl font-semibold text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-all duration-200 flex items-center active">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                Account
              </button>
            </li>
            <li>
              <button onclick="switchTab('profile')" data-tab="profile" class="tab-button w-full text-left px-4 py-3 rounded-xl font-semibold text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-all duration-200 flex items-center">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                Profile
              </button>
            </li>
            <li>
              <button onclick="switchTab('notifications')" data-tab="notifications" class="tab-button w-full text-left px-4 py-3 rounded-xl font-semibold text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-all duration-200 flex items-center">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                </svg>
                Notifications
              </button>
            </li>
            <li>
              <button onclick="switchTab('privacy')" data-tab="privacy" class="tab-button w-full text-left px-4 py-3 rounded-xl font-semibold text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-all duration-200 flex items-center">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                Privacy
              </button>
            </li>
            <li>
              <button onclick="switchTab('preferences')" data-tab="preferences" class="tab-button w-full text-left px-4 py-3 rounded-xl font-semibold text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-all duration-200 flex items-center">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
                Preferences
              </button>
            </li>
            <li>
              <button onclick="switchTab('danger')" data-tab="danger" class="tab-button w-full text-left px-4 py-3 rounded-xl font-semibold text-gray-700 hover:bg-red-50 hover:text-red-600 transition-all duration-200 flex items-center">
                <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
                Danger Zone
              </button>
            </li>
          </ul>

          <!-- Quick Links -->
          <div class="mt-8 pt-6 border-t border-gray-200">
            <p class="text-xs font-bold text-gray-500 uppercase tracking-wide mb-3">Quick Links</p>
            <ul class="space-y-2">
              <li>
                <%= link_to user_path(@user), class: "block px-4 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors" do %>
                  View Profile
                <% end %>
              </li>
              <li>
                <%= link_to edit_user_path(@user), class: "block px-4 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors" do %>
                  Edit Profile
                <% end %>
              </li>
              <li>
                <%= link_to my_products_path, class: "block px-4 py-2 text-sm font-medium text-gray-600 hover:text-blue-600 transition-colors" do %>
                  My Products
                <% end %>
              </li>
            </ul>
          </div>
        </nav>
      </div>

      <!-- Main Content Area -->
      <div class="lg:col-span-3">
        <%= form_with(model: @user, url: settings_path, method: :patch, local: true, multipart: true) do |f| %>
          <!-- Account Settings Tab -->
          <div id="account-tab" class="tab-content active animate-slide-up" style="animation-delay: 0.4s;">
            <div class="bg-white rounded-3xl shadow-2xl border border-gray-200/50 p-8 md:p-10">
              <h2 class="text-3xl font-extrabold text-gray-900 mb-8 flex items-center" style="letter-spacing: -0.01em;">
                <span class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 text-white rounded-xl flex items-center justify-center text-lg font-bold mr-4 shadow-lg">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </span>
                Account Settings
              </h2>

              <div class="space-y-6">
                <!-- Email -->
                <div>
                  <%= f.label :email, "Email Address", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <%= f.email_field :email,
                      class: "w-full px-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base font-medium",
                      required: true %>
                  <p class="mt-2 text-sm text-gray-500">
                    <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                    </svg>
                    Used for magic link authentication and important notifications
                  </p>
                </div>

                <!-- Username -->
                <div>
                  <%= f.label :username, "Username", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                      <span class="text-gray-500 text-base font-medium">@</span>
                    </div>
                    <%= f.text_field :username,
                        class: "w-full pl-10 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base font-medium",
                        required: true,
                        maxlength: 30,
                        pattern: "[a-zA-Z0-9_]+",
                        title: "Only letters, numbers, and underscores allowed" %>
                  </div>
                  <% if @user.username_changed_at.present? %>
                    <p class="mt-2 text-sm text-amber-600">
                      <svg class="w-4 h-4 inline mr-1" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                      </svg>
                      Last changed <%= time_ago_in_words(@user.username_changed_at) %> ago. Can only change once per 30 days.
                    </p>
                  <% end %>
                </div>

                <!-- Full Name -->
                <div>
                  <%= f.label :full_name, "Full Name", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <%= f.text_field :full_name,
                      class: "w-full px-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base font-medium",
                      required: true,
                      maxlength: 100 %>
                </div>
              </div>

              <div class="mt-8 flex justify-end">
                <%= f.submit "Save Account Settings", class: "px-8 py-4 border-2 border-transparent rounded-xl text-base font-bold text-white bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 focus:outline-none focus:ring-4 focus:ring-blue-500/50 shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5" %>
              </div>
            </div>
          </div>

          <!-- Profile Settings Tab -->
          <div id="profile-tab" class="tab-content">
            <div class="bg-white rounded-3xl shadow-2xl border border-gray-200/50 p-8 md:p-10">
              <h2 class="text-3xl font-extrabold text-gray-900 mb-8 flex items-center" style="letter-spacing: -0.01em;">
                <span class="w-12 h-12 bg-gradient-to-br from-purple-500 to-pink-600 text-white rounded-xl flex items-center justify-center text-lg font-bold mr-4 shadow-lg">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </span>
                Profile Information
              </h2>

              <div class="space-y-6">
                <!-- Bio -->
                <div>
                  <%= f.label :bio, "Bio", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <%= f.text_area :bio,
                      placeholder: "Tell the community about yourself...",
                      rows: 5,
                      class: "w-full px-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base leading-relaxed",
                      maxlength: 500 %>
                  <div class="mt-2 flex items-center justify-between">
                    <p class="text-sm text-gray-500">A brief description about yourself</p>
                    <span class="text-sm font-semibold text-gray-400"><span id="bio-count"><%= @user.bio&.length || 0 %></span>/500</span>
                  </div>
                </div>

                <!-- Location -->
                <div>
                  <%= f.label :location, "Location", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <%= f.text_field :location,
                      placeholder: "e.g., Accra, Ghana",
                      class: "w-full px-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base font-medium" %>
                </div>

                <!-- Website -->
                <div>
                  <%= f.label :website_url, "Website", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                      <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                      </svg>
                    </div>
                    <%= f.url_field :website_url,
                        placeholder: "https://yourwebsite.com",
                        class: "w-full pl-14 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base" %>
                  </div>
                </div>

                <!-- Twitter -->
                <div>
                  <%= f.label :twitter_handle, "Twitter", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                      <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/>
                      </svg>
                    </div>
                    <%= f.text_field :twitter_handle,
                        placeholder: "@username",
                        class: "w-full pl-14 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base" %>
                  </div>
                </div>

                <!-- GitHub -->
                <div>
                  <%= f.label :github, "GitHub", class: "block text-sm font-bold text-gray-700 mb-2" %>
                  <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                      <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
                      </svg>
                    </div>
                    <%= f.text_field :github,
                        placeholder: "username",
                        class: "w-full pl-14 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base" %>
                  </div>
                </div>
              </div>

              <div class="mt-8 flex justify-end">
