<% content_for :title, "Edit Profile - AfriHunt" %>

<style>
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes pulse-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }
  
  .animate-slide-up { animation: slide-up 0.6s ease-out forwards; }
  .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-purple-50/30">
  <!-- Header -->
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-600 via-purple-600 to-pink-500 text-white">
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="text-center">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 mb-6 animate-slide-up">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span class="text-sm font-semibold tracking-wide">Profile Settings</span>
        </div>
        
        <h1 class="text-4xl md:text-5xl font-extrabold mb-4 animate-slide-up" style="animation-delay: 0.1s; letter-spacing: -0.02em;">
          Edit Your Profile
        </h1>
        <p class="text-xl text-blue-100 max-w-2xl mx-auto animate-slide-up" style="animation-delay: 0.2s; font-weight: 300;">
          Update your information and customize how you appear to the AfriHunt community
        </p>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Form Card -->
    <div class="bg-white rounded-3xl shadow-2xl border border-gray-200/50 overflow-hidden animate-slide-up" style="animation-delay: 0.3s;">
      <%= form_with(model: @user, url: user_path(@user), method: :patch, local: true, class: "space-y-8 p-8 md:p-10") do |f| %>
        <!-- Error Messages -->
        <% if @user.errors.any? %>
          <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-xl">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-base font-bold text-red-800 mb-2">
                  <%= pluralize(@user.errors.count, "error") %> prohibited this profile from being saved:
                </h3>
                <ul class="list-disc list-inside text-sm text-red-700 space-y-1">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Section 1: Basic Information -->
        <div>
          <h2 class="text-2xl font-extrabold text-gray-900 mb-6 flex items-center" style="letter-spacing: -0.01em;">
            <span class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 text-white rounded-xl flex items-center justify-center text-sm font-bold mr-3 shadow-lg">1</span>
            Basic Information
          </h2>

          <div class="space-y-6">
            <!-- Avatar Upload -->
            <div>
              <%= f.label :avatar, "Profile Picture", class: "block text-sm font-bold text-gray-700 mb-4" %>

              <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
                <!-- Current Avatar Preview -->
                <div class="relative group">
                  <div class="absolute -inset-1 bg-gradient-to-r from-blue-400 via-purple-400 to-pink-400 rounded-full blur-lg opacity-30 group-hover:opacity-50 transition duration-500"></div>
                  <div id="avatar-preview" class="relative w-32 h-32 rounded-full bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-xl border-4 border-white overflow-hidden">
                    <% if @user.avatar.attached? %>
                      <%= image_tag @user.avatar, class: "w-full h-full object-cover", alt: @user.full_name %>
                    <% else %>
                      <span class="text-5xl font-extrabold text-white"><%= @user.avatar_initials %></span>
                    <% end %>
                  </div>
                </div>

                <!-- Upload Controls -->
                <div class="flex-1">
                  <div class="relative">
                    <%= f.file_field :avatar,
                        accept: "image/jpeg,image/jpg,image/png,image/gif,image/webp",
                        class: "hidden",
                        id: "avatar-upload",
                        onchange: "previewAvatar(event)" %>

                    <label for="avatar-upload" class="inline-flex items-center px-6 py-3 border-2 border-blue-500 rounded-xl text-base font-bold text-blue-600 bg-blue-50 hover:bg-blue-100 hover:border-blue-600 focus:outline-none focus:ring-4 focus:ring-blue-500/20 transition-all duration-200 cursor-pointer">
                      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                      </svg>
                      Choose Image
                    </label>

                    <% if @user.avatar.attached? %>
                      <button type="button" onclick="removeAvatar()" class="ml-3 inline-flex items-center px-6 py-3 border-2 border-red-300 rounded-xl text-base font-bold text-red-600 bg-red-50 hover:bg-red-100 hover:border-red-400 focus:outline-none focus:ring-4 focus:ring-red-500/20 transition-all duration-200">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Remove
                      </button>
                    <% end %>
                  </div>

                  <p class="mt-3 text-sm text-gray-500">
                    <span class="font-semibold">Recommended:</span> Square image, at least 400x400px<br>
                    <span class="font-semibold">Formats:</span> JPG, PNG, GIF, or WebP (max 5MB)
                  </p>
                </div>
              </div>
            </div>
            <!-- Full Name -->
            <div>
              <%= f.label :full_name, "Full Name", class: "block text-sm font-bold text-gray-700 mb-2" %>
              <%= f.text_field :full_name, 
                  placeholder: "Your full name",
                  class: "w-full px-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base font-medium",
                  required: true,
                  maxlength: 100 %>
              <p class="mt-2 text-sm text-gray-500">Your name as it will appear across AfriHunt (2-100 characters)</p>
            </div>

            <!-- Username -->
            <div>
              <%= f.label :username, "Username", class: "block text-sm font-bold text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                  <span class="text-gray-500 text-base font-medium">@</span>
                </div>
                <%= f.text_field :username, 
                    placeholder: "username",
                    class: "w-full pl-10 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base font-medium",
                    required: true,
                    maxlength: 30,
                    pattern: "[a-zA-Z0-9_]+",
                    title: "Only letters, numbers, and underscores allowed" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Your unique identifier (3-30 characters, letters, numbers, and underscores only)</p>
            </div>

            <!-- Bio -->
            <div>
              <%= f.label :bio, "Bio", class: "block text-sm font-bold text-gray-700 mb-2" %>
              <%= f.text_area :bio, 
                  placeholder: "Tell the community about yourself, your interests, and what you're building...",
                  rows: 5,
                  class: "w-full px-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base leading-relaxed",
                  maxlength: 500 %>
              <div class="mt-2 flex items-center justify-between">
                <p class="text-sm text-gray-500">A brief description about yourself (max 500 characters)</p>
                <span class="text-sm font-semibold text-gray-400"><span id="bio-count"><%= @user.bio&.length || 0 %></span>/500</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Section 2: Social Links -->
        <div class="pt-8 border-t-2 border-gray-100">
          <h2 class="text-2xl font-extrabold text-gray-900 mb-6 flex items-center" style="letter-spacing: -0.01em;">
            <span class="w-10 h-10 bg-gradient-to-br from-purple-500 to-pink-600 text-white rounded-xl flex items-center justify-center text-sm font-bold mr-3 shadow-lg">2</span>
            Social Links
          </h2>

          <div class="space-y-6">
            <!-- Website -->
            <div>
              <%= f.label :website_url, "Website", class: "block text-sm font-bold text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                  </svg>
                </div>
                <%= f.url_field :website_url, 
                    placeholder: "https://yourwebsite.com",
                    class: "w-full pl-14 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Your personal website or portfolio</p>
            </div>

            <!-- Twitter -->
            <div>
              <%= f.label :twitter_handle, "Twitter", class: "block text-sm font-bold text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/>
                  </svg>
                </div>
                <%= f.text_field :twitter_handle, 
                    placeholder: "@username",
                    class: "w-full pl-14 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base",
                    pattern: "@?[a-zA-Z0-9_]+",
                    title: "Twitter handle (with or without @)" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Your Twitter handle (with or without @)</p>
            </div>

            <!-- GitHub -->
            <div>
              <%= f.label :github, "GitHub", class: "block text-sm font-bold text-gray-700 mb-2" %>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none">
                  <svg class="h-5 w-5 text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <%= f.text_field :github, 
                    placeholder: "username",
                    class: "w-full pl-14 pr-5 py-4 border-2 border-gray-300 rounded-xl focus:ring-4 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 text-base" %>
              </div>
              <p class="mt-2 text-sm text-gray-500">Your GitHub username</p>
            </div>
          </div>
        </div>

        <!-- Help Text -->
        <div class="pt-8 border-t-2 border-gray-100">
          <div class="bg-gradient-to-br from-blue-50 to-purple-50 border-l-4 border-blue-500 p-6 rounded-xl">
            <div class="flex">
              <div class="flex-shrink-0">
                <svg class="h-6 w-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-3">
                <h3 class="text-base font-bold text-blue-900 mb-2">Profile Tips</h3>
                <ul class="text-sm text-blue-800 space-y-1 list-disc list-inside">
                  <li>Use a clear, professional name that represents you</li>
                  <li>Write a compelling bio that highlights your expertise and interests</li>
                  <li>Add social links to help the community connect with you</li>
                  <li>Your profile is public and visible to all AfriHunt users</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t-2 border-gray-100">
          <%= link_to user_path(@user), class: "w-full sm:w-auto order-2 sm:order-1 px-8 py-4 border-2 border-gray-300 rounded-xl text-base font-bold text-gray-700 bg-white hover:bg-gray-50 hover:border-gray-400 focus:outline-none focus:ring-4 focus:ring-gray-300/50 transition-all duration-200 text-center" do %>
            <svg class="w-5 h-5 inline mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Cancel
          <% end %>
          
          <%= f.submit "Save Changes", class: "w-full sm:w-auto order-1 sm:order-2 group relative px-10 py-4 border-2 border-transparent rounded-xl text-base font-bold text-white bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 focus:outline-none focus:ring-4 focus:ring-blue-500/50 shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-0.5" %>
        </div>
      <% end %>
    </div>

    <!-- Back to Profile -->
    <div class="mt-8 text-center">
      <%= link_to user_path(@user), class: "inline-flex items-center text-base font-semibold text-gray-600 hover:text-gray-900 transition-colors duration-200" do %>
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Back to Profile
      <% end %>
    </div>
  </div>
</div>

<script>
  // Character counter for bio
  document.addEventListener('DOMContentLoaded', function() {
    const bioField = document.querySelector('textarea[name="user[bio]"]');
    const bioCount = document.getElementById('bio-count');

    if (bioField && bioCount) {
      bioField.addEventListener('input', function() {
        bioCount.textContent = this.value.length;
      });
    }
  });

  // Avatar preview
  function previewAvatar(event) {
    const file = event.target.files[0];
    if (!file) return;

    // Validate file size (5MB)
    if (file.size > 5 * 1024 * 1024) {
      alert('File size must be less than 5MB');
      event.target.value = '';
      return;
    }

    // Validate file type
    const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif', 'image/webp'];
    if (!validTypes.includes(file.type)) {
      alert('Please upload a valid image file (JPG, PNG, GIF, or WebP)');
      event.target.value = '';
      return;
    }

    // Preview the image
    const reader = new FileReader();
    reader.onload = function(e) {
      const preview = document.getElementById('avatar-preview');
      preview.innerHTML = `<img src="${e.target.result}" class="w-full h-full object-cover" alt="Avatar preview">`;
    };
    reader.readAsDataURL(file);
  }

  // Remove avatar
  function removeAvatar() {
    if (!confirm('Are you sure you want to remove your profile picture?')) {
      return;
    }

    // Add a hidden field to mark avatar for deletion
    const form = document.querySelector('form');
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'user[remove_avatar]';
    input.value = '1';
    form.appendChild(input);

    // Reset preview to initials
    const preview = document.getElementById('avatar-preview');
    const initials = preview.querySelector('span')?.textContent || '<%= @user.avatar_initials %>';
    preview.innerHTML = `<span class="text-5xl font-extrabold text-white">${initials}</span>`;

    // Clear file input
    document.getElementById('avatar-upload').value = '';

    // Hide remove button
    event.target.closest('button').style.display = 'none';
  }
</script>
