<% content_for :title, "#{@user.full_name} (@#{@user.username}) - AfriHunt" %>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(5deg); }
  }
  
  @keyframes pulse-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 0.8; }
  }
  
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  @keyframes badge-shine {
    0% { background-position: -200% center; }
    100% { background-position: 200% center; }
  }
  
  .animate-float { animation: float 6s ease-in-out infinite; }
  .animate-pulse-glow { animation: pulse-glow 3s ease-in-out infinite; }
  .animate-slide-up { animation: slide-up 0.6s ease-out forwards; }
  .animate-badge-shine { 
    background-size: 200% auto;
    animation: badge-shine 3s linear infinite;
  }
  
  .glass-effect {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
</style>

<div class="min-h-screen bg-gradient-to-br from-gray-50 via-blue-50/30 to-purple-50/30">
  <!-- Profile Header -->
  <div class="relative overflow-hidden bg-gradient-to-br from-blue-600 via-purple-600 to-pink-500">
    <!-- Animated Background Patterns -->
    <div class="absolute inset-0 opacity-10">
      <svg class="absolute top-10 right-20 w-32 h-32 text-white animate-float" style="animation-delay: 0s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M44.7,-76.4C58.8,-69.2,71.8,-59.1,79.6,-45.8C87.4,-32.6,90,-16.3,88.5,-0.9C87,14.6,81.4,29.2,73.1,42.8C64.8,56.4,53.8,69,40.3,76.8C26.8,84.6,11.1,87.6,-4.8,85.9C-20.7,84.2,-41.4,77.8,-56.6,67.1C-71.8,56.4,-81.5,41.4,-85.6,25.1C-89.7,8.8,-88.2,-8.8,-82.3,-24.7C-76.4,-40.6,-66.1,-54.8,-53.1,-62.3C-40.1,-69.8,-24.4,-70.6,-9.3,-73.9C5.8,-77.2,30.6,-83.6,44.7,-76.4Z" transform="translate(100 100)" />
      </svg>
      <svg class="absolute bottom-10 left-20 w-40 h-40 text-white animate-float" style="animation-delay: 1.5s;" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <path fill="currentColor" d="M39.5,-65.5C51.4,-58.3,61.3,-47.6,68.4,-35.2C75.5,-22.8,79.8,-8.7,79.3,5.3C78.8,19.3,73.5,33.2,65.1,45.3C56.7,57.4,45.2,67.7,32.1,73.4C19,79.1,4.3,80.2,-10.3,77.8C-24.9,75.4,-39.4,69.5,-51.8,60.3C-64.2,51.1,-74.5,38.6,-78.9,24.5C-83.3,10.4,-81.8,-5.3,-76.2,-19.4C-70.6,-33.5,-60.9,-46,-48.8,-53.6C-36.7,-61.2,-22.2,-63.9,-8.3,-66.8C5.6,-69.7,27.6,-72.7,39.5,-65.5Z" transform="translate(100 100)" />
      </svg>
    </div>
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
    
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-8">
        <!-- Avatar -->
        <div class="relative group animate-slide-up">
          <div class="absolute -inset-2 bg-gradient-to-r from-yellow-400 via-pink-400 to-purple-400 rounded-full blur-xl opacity-50 group-hover:opacity-75 transition duration-500 animate-pulse-glow"></div>
          <div class="relative w-32 h-32 md:w-40 md:h-40 rounded-full bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 flex items-center justify-center shadow-2xl border-4 border-white overflow-hidden">
            <% if @user.avatar.attached? %>
              <%= image_tag @user.avatar, class: "w-full h-full object-cover", alt: @user.full_name %>
            <% else %>
              <span class="text-6xl md:text-7xl font-extrabold text-white"><%= @user.avatar_initials %></span>
            <% end %>
          </div>
          <% if @user.verified? %>
            <div class="absolute -bottom-2 -right-2 w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-full flex items-center justify-center shadow-lg border-3 border-white">
              <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
          <% end %>
        </div>
        
        <!-- User Info -->
        <div class="flex-1 text-center md:text-left">
          <div class="animate-slide-up" style="animation-delay: 0.1s;">
            <div class="flex flex-col md:flex-row md:items-center gap-3 mb-3">
              <h1 class="text-4xl md:text-5xl font-extrabold text-white" style="letter-spacing: -0.02em;">
                <%= @user.full_name %>
              </h1>
              <% if @user.maker_status? %>
                <span class="inline-flex items-center px-4 py-1.5 rounded-lg text-sm font-bold bg-gradient-to-r from-yellow-400 to-orange-400 text-white shadow-lg animate-badge-shine">
                  <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                  MAKER
                </span>
              <% end %>
            </div>
            
            <p class="text-xl text-blue-100 mb-4">@<%= @user.username %></p>
            
            <% if @user.bio.present? %>
              <p class="text-lg text-blue-100 mb-6 max-w-3xl leading-relaxed" style="font-weight: 300;">
                <%= @user.bio %>
              </p>
            <% end %>
            
            <!-- Social Links -->
            <div class="flex flex-wrap justify-center md:justify-start gap-3 mb-6">
              <% if @user.website_url.present? %>
                <%= link_to @user.website_url, target: "_blank", class: "inline-flex items-center px-4 py-2 glass-effect rounded-xl text-white hover:bg-white/20 transition-all duration-200" do %>
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
                  </svg>
                  Website
                <% end %>
              <% end %>
              
              <% if @user.twitter_handle.present? %>
                <%= link_to "https://twitter.com/#{@user.twitter_handle.delete('@')}", target: "_blank", class: "inline-flex items-center px-4 py-2 glass-effect rounded-xl text-white hover:bg-white/20 transition-all duration-200" do %>
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"/>
                  </svg>
                  Twitter
                <% end %>
              <% end %>
            </div>
          </div>
          
          <!-- Stats -->
          <div class="flex flex-wrap justify-center md:justify-start gap-6 animate-slide-up" style="animation-delay: 0.2s;">
            <div class="text-center">
              <div class="text-3xl font-extrabold text-white"><%= @total_products %></div>
              <div class="text-sm text-blue-200 font-medium tracking-wide">Products</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-extrabold text-white"><%= @total_upvotes_received %></div>
              <div class="text-sm text-blue-200 font-medium tracking-wide">Upvotes</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-extrabold text-white"><%= @total_followers %></div>
              <div class="text-sm text-blue-200 font-medium tracking-wide">Followers</div>
            </div>
            <div class="text-center">
              <div class="text-3xl font-extrabold text-white"><%= @total_following %></div>
              <div class="text-sm text-blue-200 font-medium tracking-wide">Following</div>
            </div>
          </div>
        </div>
        
        <!-- Action Buttons -->
        <div class="flex flex-col gap-3 animate-slide-up" style="animation-delay: 0.3s;">
          <% if user_signed_in? && current_user == @user %>
            <%= link_to edit_user_path(@user), class: "group inline-flex items-center justify-center px-6 py-3 bg-white text-gray-900 rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5" do %>
              <svg class="w-5 h-5 mr-2 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
              Edit Profile
            <% end %>
          <% elsif user_signed_in? %>
            <button class="group inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-500 to-purple-500 text-white rounded-xl font-semibold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
              </svg>
              Follow
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Tab Navigation -->
    <div class="mb-10">
      <div class="border-b border-gray-200">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
          <a href="#products" class="border-blue-500 text-blue-600 whitespace-nowrap py-4 px-1 border-b-2 font-bold text-lg">
            Products
            <span class="ml-2 px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-600"><%= @total_products %></span>
          </a>
          <a href="#upvoted" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-lg transition-colors duration-200">
            Upvoted
            <span class="ml-2 px-2.5 py-0.5 rounded-full text-xs font-bold bg-gray-100 text-gray-600"><%= @user.upvoted_products.count %></span>
          </a>
          <a href="#activity" class="border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 whitespace-nowrap py-4 px-1 border-b-2 font-semibold text-lg transition-colors duration-200">
            Activity
          </a>
        </nav>
      </div>
    </div>

    <!-- Products Section -->
    <div id="products" class="mb-16">
      <% if @products.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @products.each_with_index do |product, index| %>
            <%= link_to product_path(product), class: "group" do %>
              <div class="h-full animate-slide-up" style="animation-delay: <%= index * 0.05 %>s;">
                <div class="relative h-full bg-white rounded-2xl shadow-md border border-gray-200/50 overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 group-hover:border-transparent">
                  <!-- Gradient Border on Hover -->
                  <div class="absolute inset-0 bg-gradient-to-br from-blue-500 via-purple-500 to-pink-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl" style="padding: 2px;">
                    <div class="h-full w-full bg-white rounded-2xl"></div>
                  </div>
                  
                  <div class="relative p-6 h-full flex flex-col">
                    <!-- Header -->
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex-1 min-w-0">
                        <h3 class="text-xl font-extrabold text-gray-900 mb-2 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-300 truncate" style="letter-spacing: -0.01em;">
                          <%= product.name %>
                        </h3>
                        <p class="text-gray-600 text-sm leading-relaxed line-clamp-2 min-h-[2.5rem]">
                          <%= truncate(product.tagline, length: 100) %>
                        </p>
                      </div>
                      
                      <!-- Upvote Button -->
                      <div class="ml-4 flex-shrink-0">
                        <div class="flex flex-col items-center px-4 py-3 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl border border-gray-200 shadow-sm">
                          <svg class="w-5 h-5 text-gray-600 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                          </svg>
                          <span class="text-base font-extrabold text-gray-900"><%= product.upvotes_count %></span>
                        </div>
                      </div>
                    </div>
                    
                    <!-- Topics -->
                    <div class="flex flex-wrap gap-2 mb-4">
                      <% product.topics.first(3).each do |topic| %>
                        <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-semibold bg-gradient-to-r from-gray-100 to-gray-50 text-gray-700 border border-gray-200">
                          <% if topic.icon.present? %>
                            <span class="mr-1.5"><%= topic.icon %></span>
                          <% end %>
                          <%= topic.name %>
                        </span>
                      <% end %>
                    </div>
                    
                    <!-- Spacer -->
                    <div class="flex-grow"></div>
                    
                    <!-- Footer -->
                    <div class="flex items-center justify-between pt-4 mt-4 border-t border-gray-100">
                      <div class="flex items-center text-sm text-gray-500">
                        <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                        <%= time_ago_in_words(product.created_at) %> ago
                      </div>
                      <div class="flex items-center text-sm text-gray-500">
                        <svg class="w-4 h-4 mr-1.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        <span class="font-semibold"><%= product.comments_count %></span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="text-center py-16">
          <div class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-gray-100 to-gray-200 rounded-full flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">No products yet</h3>
          <p class="text-gray-600 mb-6">
            <%= @user.full_name %> hasn't launched any products yet.
          </p>
        </div>
      <% end %>
    </div>

    <!-- Upvoted Products Section -->
    <div id="upvoted" class="mb-16">
      <div class="mb-8">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-2" style="letter-spacing: -0.01em;">Upvoted Products</h2>
        <p class="text-lg text-gray-600">Products <%= @user.full_name %> has shown love to</p>
      </div>

      <% if @upvoted_products.any? %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @upvoted_products.each_with_index do |product, index| %>
            <%= link_to product_path(product), class: "group" do %>
              <div class="h-full animate-slide-up" style="animation-delay: <%= index * 0.05 %>s;">
                <div class="relative h-full bg-white rounded-2xl shadow-md border border-gray-200/50 overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2">
                  <div class="p-6">
                    <div class="flex items-start justify-between mb-4">
                      <div class="flex-1 min-w-0">
                        <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors truncate">
                          <%= product.name %>
                        </h3>
                        <p class="text-gray-600 text-sm leading-relaxed line-clamp-2">
                          <%= truncate(product.tagline, length: 80) %>
                        </p>
                      </div>

                      <div class="ml-4 flex-shrink-0">
                        <div class="flex flex-col items-center px-3 py-2 bg-gradient-to-br from-blue-50 to-purple-50 rounded-xl border border-blue-200">
                          <svg class="w-4 h-4 text-blue-600 mb-1" fill="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                          </svg>
                          <span class="text-sm font-bold text-gray-900"><%= product.upvotes_count %></span>
                        </div>
                      </div>
                    </div>

                    <div class="flex items-center pt-4 border-t border-gray-100">
                      <div class="w-7 h-7 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-sm">
                        <span class="text-white text-xs font-bold"><%= product.makers.first.full_name.first if product.makers.any? %></span>
                      </div>
                      <span class="ml-2 text-sm font-semibold text-gray-700 truncate">
                        by <%= product.makers.first.full_name if product.makers.any? %>
                      </span>
                    </div>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16 bg-white rounded-2xl border border-gray-200">
          <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-blue-100 to-purple-100 rounded-full flex items-center justify-center">
            <svg class="w-10 h-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">No upvoted products yet</h3>
          <p class="text-gray-600">
            <%= @user.full_name %> hasn't upvoted any products yet.
          </p>
        </div>
      <% end %>
    </div>

    <!-- Activity Section -->
    <div id="activity" class="mb-16">
      <div class="mb-8">
        <h2 class="text-3xl font-extrabold text-gray-900 mb-2" style="letter-spacing: -0.01em;">Recent Activity</h2>
        <p class="text-lg text-gray-600">Latest comments and interactions</p>
      </div>

      <% if @recent_comments.any? %>
        <div class="space-y-6">
          <% @recent_comments.each_with_index do |comment, index| %>
            <div class="bg-white rounded-2xl shadow-md border border-gray-200/50 p-6 hover:shadow-lg transition-all duration-300 animate-slide-up" style="animation-delay: <%= index * 0.05 %>s;">
              <div class="flex items-start gap-4">
                <!-- Avatar -->
                <div class="flex-shrink-0">
                  <div class="w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-purple-600 flex items-center justify-center shadow-md">
                    <span class="text-white text-sm font-bold"><%= @user.full_name.first.upcase %></span>
                  </div>
                </div>

                <!-- Comment Content -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="font-bold text-gray-900"><%= @user.full_name %></span>
                    <span class="text-gray-500">commented on</span>
                    <%= link_to comment.product.name, product_path(comment.product), class: "font-semibold text-blue-600 hover:text-blue-700 transition-colors" %>
                  </div>

                  <p class="text-gray-700 leading-relaxed mb-3">
                    <%= truncate(comment.body, length: 200) %>
                  </p>

                  <div class="flex items-center gap-4 text-sm text-gray-500">
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                      </svg>
                      <%= time_ago_in_words(comment.created_at) %> ago
                    </span>
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7"/>
                      </svg>
                      <%= comment.upvotes_count %> upvotes
                    </span>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-16 bg-white rounded-2xl border border-gray-200">
          <div class="w-20 h-20 mx-auto mb-6 bg-gradient-to-br from-purple-100 to-pink-100 rounded-full flex items-center justify-center">
            <svg class="w-10 h-10 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">No activity yet</h3>
          <p class="text-gray-600">
            <%= @user.full_name %> hasn't commented on any products yet.
          </p>
        </div>
      <% end %>
    </div>

    <!-- Collections Section (if any) -->
    <% if @collections.any? %>
      <div id="collections" class="mb-16">
        <div class="mb-8">
          <h2 class="text-3xl font-extrabold text-gray-900 mb-2" style="letter-spacing: -0.01em;">Collections</h2>
          <p class="text-lg text-gray-600">Curated product collections by <%= @user.full_name %></p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <% @collections.each_with_index do |collection, index| %>
            <%= link_to collection_path(collection), class: "group" do %>
              <div class="bg-white rounded-2xl shadow-md border border-gray-200/50 overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-2 animate-slide-up" style="animation-delay: <%= index * 0.05 %>s;">
                <div class="p-6">
                  <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-transparent group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 group-hover:bg-clip-text transition-all duration-300">
                    <%= collection.name %>
                  </h3>
                  <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                    <%= collection.description %>
                  </p>
                  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <span class="text-sm text-gray-500">
                      <%= pluralize(collection.products.count, 'product') %>
                    </span>
                    <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-600 group-hover:translate-x-1 transition-all duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                  </div>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
